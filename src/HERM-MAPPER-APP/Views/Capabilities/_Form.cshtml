@using System.Text.Json
@model CapabilityEditViewModel
@{
    var armComponentLookupJson = JsonSerializer.Serialize(
        Model.ArmComponentLookupOptions.Select(option => new
        {
            option.ArmComponentId,
            option.ArmComponentLabel,
            CapabilityOptions = option.CapabilityOptions.Select(capability => new
            {
                capability.ArmCapabilityId,
                capability.ArmDomainLabel,
                capability.ArmCapabilityLabel,
                capability.ConnectionLabel
            })
        }),
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="content-card mb-4">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Capability record</span>
                    <h2>Details</h2>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="SelectedBrmComponentId" class="form-label"></label>
                    <select asp-for="SelectedBrmComponentId" class="form-select" asp-items="Model.BrmComponentOptions">
                        <option value="">Choose a BRM capability</option>
                    </select>
                    <span asp-validation-for="SelectedBrmComponentId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="content-card" data-collection-editor data-capability-mapping-editor>
            <div class="section-heading">
                <div>
                    <span class="eyebrow">HERM links</span>
                    <h2>BRM to ARM mappings</h2>
                    <p>Select the supporting ARM component first. If that component links to multiple ARM capabilities, choose the specific ARM capability connection.</p>
                </div>
            </div>

            <div asp-validation-for="MappingRows" class="text-danger mb-3"></div>
            <script type="application/json" data-capability-arm-component-options>@Html.Raw(armComponentLookupJson)</script>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>ARM component</th>
                            <th>ARM capability</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody data-collection-editor-rows>
                    @for (var index = 0; index < Model.MappingRows.Count; index++)
                    {
                        <tr data-collection-editor-row>
                            <td>
                                <select asp-for="MappingRows[index].ArmComponentId"
                                        class="form-select"
                                        asp-items="Model.ArmComponentOptions"
                                        data-capability-arm-component-select>
                                    <option value="">Choose an ARM component</option>
                                </select>
                                <span asp-validation-for="MappingRows[index].ArmComponentId" class="text-danger"></span>
                            </td>
                            <td>
                                <select asp-for="MappingRows[index].ArmCapabilityId"
                                        class="form-select"
                                        asp-items="Model.ArmCapabilityOptions"
                                        data-capability-arm-capability-select>
                                    <option value="">Choose an ARM capability connection</option>
                                </select>
                                <span asp-validation-for="MappingRows[index].ArmCapabilityId" class="text-danger"></span>
                            </td>
                            <td class="text-end align-top">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Mapping row actions">
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            data-collection-editor-add
                                            aria-label="Add capability mapping below this row"
                                            title="Add capability mapping below this row">
                                        +
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            data-collection-editor-remove
                                            aria-label="Remove this capability mapping row"
                                            title="Remove this capability mapping row">
                                        -
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="form-note mt-2">Use the + button on a row to add another mapping below it. The same ARM component can be reused across different ARM capability connections, but duplicate component/capability pairs are rejected.</div>
        </div>
    </div>
    <div class="col-xl-4">
        <aside class="content-card h-100">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Workflow</span>
                    <h2>What this creates</h2>
                </div>
            </div>
            <p class="mb-3">This keeps BRM as a separate business taxonomy while linking it to ARM components for future drilldown into applications, TRM components, and supporting products.</p>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Save capability</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </aside>
    </div>
</div>
