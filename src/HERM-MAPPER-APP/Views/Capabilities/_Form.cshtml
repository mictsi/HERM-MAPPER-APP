@model CapabilityEditViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="content-card mb-4">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Capability record</span>
                    <h2>Details</h2>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="content-card">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">HERM links</span>
                    <h2>BRM to ARM mappings</h2>
                    <p>Each row connects one BRM capability to one ARM component so the app can drill down further into applications and supporting TRM products.</p>
                </div>
            </div>

            <div asp-validation-for="MappingRows" class="text-danger mb-3"></div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>BRM capability</th>
                            <th>Supporting ARM component</th>
                            <th>Primary</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var index = 0; index < Model.MappingRows.Count; index++)
                    {
                        <tr>
                            <td>
                                <select asp-for="MappingRows[index].BrmComponentId" class="form-select" asp-items="Model.BrmComponentOptions">
                                    <option value="">Choose a BRM capability</option>
                                </select>
                                <span asp-validation-for="MappingRows[index].BrmComponentId" class="text-danger"></span>
                            </td>
                            <td>
                                <select asp-for="MappingRows[index].ArmComponentId" class="form-select" asp-items="Model.ArmComponentOptions">
                                    <option value="">Choose an ARM component</option>
                                </select>
                                <span asp-validation-for="MappingRows[index].ArmComponentId" class="text-danger"></span>
                            </td>
                            <td class="text-center">
                                <input asp-for="MappingRows[index].IsPrimary" class="form-check-input" />
                            </td>
                            <td>
                                <input asp-for="MappingRows[index].Notes" class="form-control" />
                                <span asp-validation-for="MappingRows[index].Notes" class="text-danger"></span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="form-note mt-2">Leave unused rows blank. Duplicate BRM/ARM combinations are rejected by validation.</div>
        </div>
    </div>
    <div class="col-xl-4">
        <aside class="content-card h-100">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Workflow</span>
                    <h2>What this creates</h2>
                </div>
            </div>
            <p class="mb-3">This sets up the business-to-application drilldown layer. Applications and supporting TRM products are then resolved automatically from the linked ARM components.</p>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Save capability</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </aside>
    </div>
</div>
