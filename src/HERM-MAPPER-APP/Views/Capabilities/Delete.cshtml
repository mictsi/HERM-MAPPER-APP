@using HERMMapperApp.Services
@using HERMMapperApp.ViewModels
@model CapabilityDeleteViewModel
@{
    ViewData["Title"] = "Remove Capability";
    ViewData["BodyClass"] = "brm-models-page confirmation-page capability-delete-page";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Business Layer</span>
        <h1>Remove capability from model?</h1>
        <p>This removes <strong>@Model.Name</strong> from <strong>@Model.BrmModelName</strong> and deletes its BRM to ARM mappings.</p>
    </div>
</section>

<section class="stats-grid stats-grid-compact details-overview-grid">
    <article class="stat-card details-overview-card">
        <span class="stat-label">Capability</span>
        <span class="stat-value details-overview-value-small">@Model.Name</span>
        <span class="stat-meta">business capability being removed</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">BRM model</span>
        <span class="stat-value details-overview-value-small">@Model.BrmModelName</span>
        <span class="stat-meta">parent model that will lose this node</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">ARM links</span>
        <span class="stat-value">@Model.ArmComponentCount</span>
        <span class="stat-meta">downstream mappings removed with the capability</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Outcome</span>
        <span class="stat-value details-overview-value-small">Permanent</span>
        <span class="stat-meta">capability and BRM-to-ARM links are deleted</span>
    </article>
</section>

<section class="row g-4 confirmation-shell">
    <div class="col-xl-8">
        <section class="content-card confirmation-main-card mb-0">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Capability review</span>
                    <h2>Model details</h2>
                </div>
            </div>
            <dl class="detail-grid mb-0">
                <dt>Capability</dt>
                <dd>@Model.Name</dd>
                <dt>BRM model</dt>
                <dd>@Model.BrmModelName</dd>
                <dt>ARM components</dt>
                <dd>@Model.ArmComponentCount</dd>
                <dt>Last updated</dt>
                <dd>@await TimeZoneDisplay.FormatUtcAsync(Model.UpdatedUtc)</dd>
                <dt>Description</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
            </dl>
        </section>
    </div>
    <div class="col-xl-4">
        <aside class="content-card confirmation-side-card mb-0">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Action</span>
                    <h2>Remove capability</h2>
                </div>
            </div>
            <div class="confirmation-note mb-3">
                This removal affects the BRM model structure and clears all downstream ARM mappings attached to the capability.
            </div>
            <form asp-action="Delete" method="post" class="d-grid gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Remove capability</button>
                @if (Model.BrmModelId.HasValue)
                {
                    <a class="btn btn-outline-secondary" asp-controller="BrmModels" asp-action="Details" asp-route-id="@Model.BrmModelId">Cancel</a>
                }
                else
                {
                    <a class="btn btn-outline-secondary" asp-controller="BrmModels" asp-action="Index">Cancel</a>
                }
            </form>
        </aside>
    </div>
</section>
