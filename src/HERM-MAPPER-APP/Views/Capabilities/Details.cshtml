@using System.Text.Json
@using HERMMapperApp
@using HERMMapperApp.Services
@using HERMMapperApp.ViewModels
@model CapabilityDetailsViewModel
@{
    ViewData["Title"] = "Capability Details";
    var canManageProductsAndServices = AppRoles.CanManageProductsAndServices(User);
    var statusMessage = ViewData["StatusMessage"] as string;
    var hierarchyData = JsonSerializer.Serialize(
        Model.HierarchyRoot,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

<section class="page-header">
    <div>
        <span class="eyebrow">Business Layer</span>
        <h1>@Model.Name</h1>
        <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.BrmModelId.HasValue)
        {
            <a class="btn btn-outline-secondary" asp-controller="BrmModels" asp-action="Details" asp-route-id="@Model.BrmModelId">Back to BRM model</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-controller="BrmModels" asp-action="Index">Back to BRM models</a>
        }
        @if (canManageProductsAndServices)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit capability</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Remove capability</a>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

<section class="content-card mb-4">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Summary</span>
            <h2>Capability overview</h2>
        </div>
    </div>
    <dl class="detail-grid">
        <dt>BRM model</dt>
        <dd>@Model.BrmModelName</dd>
        <dt>Area</dt>
        <dd>@Model.BrmModelArea</dd>
        <dt>Model status</dt>
        <dd>@Model.BrmModelStatus</dd>
        <dt>BRM capabilities</dt>
        <dd>@Model.BrmCapabilityCount</dd>
        <dt>ARM components</dt>
        <dd>@Model.ArmComponentCount</dd>
        <dt>Applications</dt>
        <dd>@Model.ApplicationCount</dd>
        <dt>Products</dt>
        <dd>@Model.ProductCount</dd>
        <dt>Last updated</dt>
        <dd>@await TimeZoneDisplay.FormatUtcAsync(Model.UpdatedUtc)</dd>
        <dt>Notes</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</dd>
    </dl>
</section>

<section class="content-card mb-4">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Links</span>
            <h2>@Model.MappingRows.Count BRM/ARM mapping(s)</h2>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>BRM domain</th>
                    <th>BRM capability</th>
                    <th>BRM level 2</th>
                    <th>ARM domain</th>
                    <th>ARM capability</th>
                    <th>ARM component</th>
                    <th>Linked applications</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var mapping in Model.MappingRows)
            {
                <tr>
                    <td>@mapping.BrmDomainLabel</td>
                    <td>@mapping.BrmCapabilityLabel</td>
                    <td>@mapping.BrmComponentLabel</td>
                    <td>@mapping.ArmDomainLabel</td>
                    <td>@mapping.ArmCapabilityLabel</td>
                    <td>@mapping.ArmComponentLabel</td>
                    <td>@mapping.LinkedApplicationCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="content-card mb-4">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Hierarchy</span>
            <h2>Capability dependency map</h2>
        </div>
    </div>

    @if (!Model.HasResolvedPaths)
    {
        <div class="empty-state compact">
            <h3>No dependency tree yet</h3>
            <p>Add BRM to ARM mappings first, then connect applications to ARM components and TRM products to see the left-to-right drilldown.</p>
        </div>
    }
    else
    {
        <div class="application-radial-tree-shell" data-application-radial-tree-shell>
            <div class="application-radial-tree-toolbar">
                <button type="button"
                        class="application-radial-tree-fullscreen-button"
                        data-application-radial-tree-fullscreen
                        aria-label="Enter full screen"
                        title="Enter full screen">
                    <span class="application-radial-tree-fullscreen-icon" aria-hidden="true"></span>
                    <span data-application-radial-tree-fullscreen-label>Full screen</span>
                </button>
            </div>
            <script type="application/json" data-application-radial-tree-data>@Html.Raw(hierarchyData)</script>
            <div class="application-radial-tree"
                 data-application-radial-tree
                 data-empty-title="No dependency map yet"
                 data-empty-body="Add BRM to ARM mappings first, then connect applications and TRM products to see the dependency graph."></div>
            <p class="application-radial-tree-note">Drag to pan and use the mouse wheel to zoom. The tree reads from left to right, while products remain in the resolved path table below to keep the diagram readable.</p>
        </div>
    }
</section>

<section class="content-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Resolved drilldown</span>
            <h2>BRM to TRM product path</h2>
        </div>
    </div>

    @if (!Model.HasResolvedPaths)
    {
        <div class="empty-state compact">
            <h3>No resolved paths yet</h3>
            <p>Add BRM to ARM mappings first, then connect applications to ARM components and TRM products to see the full drilldown.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>BRM domain</th>
                        <th>BRM capability</th>
                        <th>BRM level 2</th>
                        <th>ARM domain</th>
                        <th>ARM capability</th>
                        <th>ARM component</th>
                        <th>Application</th>
                        <th>Product</th>
                        <th>TRM domain</th>
                        <th>TRM capability</th>
                        <th>TRM component</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var path in Model.ResolvedPaths)
                {
                    <tr>
                        <td>@path.BrmDomainLabel</td>
                        <td>@path.BrmCapabilityLabel</td>
                        <td>@path.BrmComponentLabel</td>
                        <td>@path.ArmDomainLabel</td>
                        <td>@path.ArmCapabilityLabel</td>
                        <td>@path.ArmComponentLabel</td>
                        <td>@path.ApplicationName</td>
                        <td>@path.ProductLabel</td>
                        <td>@path.TrmDomainLabel</td>
                        <td>@path.TrmCapabilityLabel</td>
                        <td>@path.TrmComponentLabel</td>
                        <td>@path.MappingStatus</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/application-radial-tree.js" asp-append-version="true"></script>
}
