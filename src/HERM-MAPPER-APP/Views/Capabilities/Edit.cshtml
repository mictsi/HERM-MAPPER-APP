@model CapabilityEditViewModel
@{
    ViewData["Title"] = "Edit Capability";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Business Layer</span>
        <h1>Edit @Model.Name</h1>
        <p>Update the BRM to ARM links that drive the future drilldown into applications and products.</p>
    </div>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
