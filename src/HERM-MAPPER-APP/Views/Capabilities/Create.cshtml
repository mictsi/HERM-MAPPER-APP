@model CapabilityEditViewModel
@{
    ViewData["Title"] = "Add Capability";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Business Layer</span>
        <h1>Add a capability</h1>
        <p>Create the capability record, then connect BRM capabilities to the ARM components that support them.</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.SelectedBrmModelId.HasValue)
        {
            <a class="btn btn-outline-secondary" asp-controller="BrmModels" asp-action="Details" asp-route-id="@Model.SelectedBrmModelId">Back to BRM model</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-controller="BrmModels" asp-action="Index">Back to BRM models</a>
        }
    </div>
</section>

<form asp-action="Create" asp-route-brmModelId="@Model.SelectedBrmModelId" method="post">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
