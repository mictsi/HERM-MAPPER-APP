@model ApplicationCatalogItem
@{
    ViewData["Title"] = "Trash Application";
    ViewData["BodyClass"] = "applications-page confirmation-page application-delete-page";
    var armComponentCount = Model.Mappings
        .Select(mapping => mapping.ArmComponentId)
        .Distinct()
        .Count();
    var productCount = Model.Mappings
        .Select(mapping => mapping.ProductCatalogItemId)
        .Distinct()
        .Count();
}

<section class="page-header">
    <div>
        <span class="eyebrow">Application Layer</span>
        <h1>Move @Model.Name to trash?</h1>
        <p>This hides the application from the active ARM catalogue. Administrators can restore it later from Admin.</p>
    </div>
</section>

<section class="stats-grid stats-grid-compact details-overview-grid">
    <article class="stat-card details-overview-card">
        <span class="stat-label">Application</span>
        <span class="stat-value details-overview-value-small">@Model.Name</span>
        <span class="stat-meta">catalogue record selected for trash</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">ARM components</span>
        <span class="stat-value">@armComponentCount</span>
        <span class="stat-meta">links retained while trashed</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Products</span>
        <span class="stat-value">@productCount</span>
        <span class="stat-meta">supporting products preserved</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Outcome</span>
        <span class="stat-value details-overview-value-small">Recoverable</span>
        <span class="stat-meta">admins can restore it later</span>
    </article>
</section>

<section class="row g-4 confirmation-shell">
    <div class="col-xl-8">
        <section class="content-card confirmation-main-card mb-0">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Record review</span>
                    <h2>Application details</h2>
                </div>
            </div>
            <dl class="detail-grid mb-0">
                <dt>Application</dt>
                <dd>@Model.Name</dd>
                <dt>Description</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
                <dt>ARM components</dt>
                <dd>@armComponentCount</dd>
                <dt>Products</dt>
                <dd>@productCount</dd>
            </dl>
        </section>
    </div>
    <div class="col-xl-4">
        <aside class="content-card confirmation-side-card mb-0">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Action</span>
                    <h2>Send to trash</h2>
                </div>
            </div>
            <div class="confirmation-note mb-3">
                The application disappears from active ARM views but keeps its mappings so an administrator can restore it later.
            </div>
            <form asp-action="Delete" method="post" class="d-grid gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Move to trash</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </form>
        </aside>
    </div>
</section>
