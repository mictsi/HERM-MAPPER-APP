@using System.Text.Json
@model ApplicationEditViewModel
@{
    var productTrmLookupJson = JsonSerializer.Serialize(
        Model.ProductTrmMappingOptions.Select(option => new
        {
            option.ProductCatalogItemId,
            option.ProductLabel,
            option.TrmComponentId,
            option.TrmComponentLabel,
            option.ProductMappingId
        }),
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="content-card mb-4">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Application record</span>
                    <h2>Details</h2>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="content-card" data-collection-editor data-application-mapping-editor>
            <div class="section-heading">
                <div>
                    <span class="eyebrow">HERM links</span>
                    <h2>ARM to product mappings</h2>
                    <p>Select the ARM component first, then the product. If the chosen product maps to more than one TRM component, choose the correct TRM component for that product. The parent ARM and TRM layers are derived automatically from those selections.</p>
                </div>
            </div>

            <div asp-validation-for="MappingRows" class="text-danger mb-3"></div>
            <script type="application/json" data-application-product-trm-options>@Html.Raw(productTrmLookupJson)</script>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>ARM component</th>
                            <th>Product</th>
                            <th>TRM component</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody data-collection-editor-rows>
                    @for (var index = 0; index < Model.MappingRows.Count; index++)
                    {
                        <tr data-collection-editor-row>
                            <td>
                                <select asp-for="MappingRows[index].ArmComponentId" class="form-select" asp-items="Model.ArmComponentOptions">
                                    <option value="">Choose an ARM component</option>
                                </select>
                                <span asp-validation-for="MappingRows[index].ArmComponentId" class="text-danger"></span>
                            </td>
                            <td>
                                <select asp-for="MappingRows[index].ProductCatalogItemId"
                                        class="form-select"
                                        asp-items="Model.ProductOptions"
                                        data-application-product-select>
                                    <option value="">Choose a product</option>
                                </select>
                                <span asp-validation-for="MappingRows[index].ProductCatalogItemId" class="text-danger"></span>
                            </td>
                            <td>
                                <select asp-for="MappingRows[index].TrmComponentId"
                                        class="form-select"
                                        asp-items="Model.TrmComponentOptions"
                                        data-application-trm-component-select>
                                    <option value="">Choose a TRM component</option>
                                </select>
                                <span asp-validation-for="MappingRows[index].TrmComponentId" class="text-danger"></span>
                            </td>
                            <td class="text-end align-top">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Mapping row actions">
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            data-collection-editor-add
                                            aria-label="Add application mapping below this row"
                                            title="Add application mapping below this row">
                                        +
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            data-collection-editor-remove
                                            aria-label="Remove this application mapping row"
                                            title="Remove this application mapping row">
                                        -
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="form-note mt-2">A product can appear in multiple mappings. If it resolves to a single TRM component, the form selects it automatically. Use the + button on a row to add another mapping below it.</div>
        </div>
    </div>
    <div class="col-xl-4">
        <aside class="content-card h-100">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Workflow</span>
                    <h2>What this creates</h2>
                </div>
            </div>
            <p class="mb-3">This creates an application record anchored to ARM components and the existing TRM product-to-component mappings, so the app can display the HERM drilldown path consistently.</p>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Save application</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </aside>
    </div>
</div>
