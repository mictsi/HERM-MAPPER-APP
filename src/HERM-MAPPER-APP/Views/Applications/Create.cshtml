@model ApplicationEditViewModel
@{
    ViewData["Title"] = "Add Application";
    ViewData["BodyClass"] = "applications-page applications-editor-page";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Application Layer</span>
        <h1>Add an application</h1>
        <p>Create the application record, then link each ARM component to the supporting TRM products.</p>
    </div>
</section>

<form asp-action="Create" method="post" class="editor-form-shell">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
