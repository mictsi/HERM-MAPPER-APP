@using System.Text.Json
@using HERMMapperApp
@using HERMMapperApp.Services
@using HERMMapperApp.ViewModels
@model ApplicationDetailsViewModel
@{
    ViewData["Title"] = "Application Details";
    ViewData["BodyClass"] = "applications-page applications-details-page";
    var canManageProductsAndServices = AppRoles.CanManageProductsAndServices(User);
    var statusMessage = ViewData["StatusMessage"] as string;
    var hierarchyData = JsonSerializer.Serialize(
        Model.HierarchyRoot,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

<section class="page-header">
    <div>
        <span class="eyebrow">Application Layer</span>
        <h1>@Model.Name</h1>
        <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back to applications</a>
        @if (canManageProductsAndServices)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit application</a>
        }
    </div>
</section>

<section class="stats-grid stats-grid-compact details-overview-grid">
    <article class="stat-card details-overview-card">
        <span class="stat-label">ARM components</span>
        <span class="stat-value">@Model.ArmComponentCount</span>
        <span class="stat-meta">linked into this application</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Products</span>
        <span class="stat-value">@Model.ProductCount</span>
        <span class="stat-meta">supporting catalogue products</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Resolved paths</span>
        <span class="stat-value">@Model.ResolvedPaths.Count</span>
        <span class="stat-meta">available dependency routes</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Mapping rows</span>
        <span class="stat-value">@Model.MappingRows.Count</span>
        <span class="stat-meta">ARM-to-product links maintained here</span>
    </article>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

<section class="content-card mb-4 details-primary-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Summary</span>
            <h2>Application overview</h2>
        </div>
    </div>
    <dl class="detail-grid">
        <dt>ARM components</dt>
        <dd>@Model.ArmComponentCount</dd>
        <dt>Products</dt>
        <dd>@Model.ProductCount</dd>
        <dt>Resolved paths</dt>
        <dd>@Model.ResolvedPaths.Count</dd>
        <dt>Last updated</dt>
        <dd>@await TimeZoneDisplay.FormatUtcAsync(Model.UpdatedUtc)</dd>
        <dt>Notes</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</dd>
    </dl>
</section>

<section class="content-card mb-4 details-primary-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Links</span>
            <h2>@Model.MappingRows.Count ARM/product mapping(s)</h2>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>ARM domain</th>
                    <th>ARM capability</th>
                    <th>ARM component</th>
                    <th>TRM domain</th>
                    <th>TRM capability</th>
                    <th>TRM component</th>
                    <th>Product</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var mapping in Model.MappingRows)
            {
                <tr>
                    <td>@mapping.ArmDomainLabel</td>
                    <td>@mapping.ArmCapabilityLabel</td>
                    <td>@mapping.ArmComponentLabel</td>
                    <td>@mapping.TrmDomainLabel</td>
                    <td>@mapping.TrmCapabilityLabel</td>
                    <td>@mapping.TrmComponentLabel</td>
                    <td>@mapping.ProductLabel</td>
                    <td>@mapping.MappingStatus</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="content-card details-primary-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Hierarchy</span>
            <h2>Application dependency map</h2>
        </div>
    </div>

    @if (!Model.HasResolvedPaths)
    {
        <div class="empty-state compact">
            <h3>No dependency tree yet</h3>
            <p>Add application mappings first, then complete the TRM product mappings to see the top-down hierarchy.</p>
        </div>
    }
    else
    {
        <div class="application-radial-tree-shell">
            <script type="application/json" data-application-radial-tree-data>@Html.Raw(hierarchyData)</script>
            <div class="application-radial-tree"
                 data-application-radial-tree
                 data-empty-title="No dependency map yet"
                 data-empty-body="Add application mappings first, then complete the TRM product mappings to see the dependency graph."></div>
            <p class="application-radial-tree-note">Drag to pan and use the mouse wheel to zoom. The tree now reads from left to right, while product endpoints stay in the mapping table above to keep the diagram readable.</p>
        </div>
    }
</section>

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/application-radial-tree.js" asp-append-version="true"></script>
}
