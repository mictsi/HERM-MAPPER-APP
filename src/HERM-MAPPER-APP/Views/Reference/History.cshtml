@model ComponentHistoryViewModel
@{
    ViewData["Title"] = "Component History";
    ViewData["BodyClass"] = "admin-page history-page reference-history-page";
    var deletedVersionCount = Model.Versions.Count(version => version.IsDeleted);
    var latestVersion = Model.Versions.Count == 0 ? 0 : Model.Versions.Max(version => version.VersionNumber);
}

<section class="page-header">
    <div>
        <span class="eyebrow">Component version history</span>
        <h1>@Model.Component.DisplayLabel</h1>
        <p>Every imported, updated, deleted, and restored state for this component.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to catalogue</a>
</section>

<section class="stats-grid stats-grid-compact admin-overview-grid">
    <article class="stat-card admin-overview-card">
        <span class="stat-label">Versions</span>
        <span class="stat-value">@Model.Versions.Count</span>
        <span class="stat-meta">captured component snapshots</span>
    </article>
    <article class="stat-card admin-overview-card">
        <span class="stat-label">Deleted states</span>
        <span class="stat-value">@deletedVersionCount</span>
        <span class="stat-meta">snapshots marked deleted</span>
    </article>
    <article class="stat-card admin-overview-card">
        <span class="stat-label">Active states</span>
        <span class="stat-value">@(Model.Versions.Count - deletedVersionCount)</span>
        <span class="stat-meta">snapshots remaining active</span>
    </article>
    <article class="stat-card admin-overview-card">
        <span class="stat-label">Latest version</span>
        <span class="stat-value">@latestVersion</span>
        <span class="stat-meta">most recent recorded version number</span>
    </article>
</section>

<section class="content-card">
    @if (Model.Versions.Count == 0)
    {
        <div class="empty-state compact">
            <h3>No versions captured yet</h3>
            <p>The next change to this component will create the first history record.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Version</th>
                        <th>Change</th>
                        <th>Capabilities</th>
                        <th>State</th>
                        <th>Changed</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var version in Model.Versions)
                {
                    <tr>
                        <td>#@version.VersionNumber</td>
                        <td>@version.ChangeType</td>
                        <td>@(string.IsNullOrWhiteSpace(version.CapabilityCodes) ? "-" : version.CapabilityCodes)</td>
                        <td>@(version.IsDeleted ? "Deleted" : "Active")</td>
                        <td>@await TimeZoneDisplay.FormatUtcAsync(version.ChangedUtc)</td>
                        <td>@(version.Details ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
