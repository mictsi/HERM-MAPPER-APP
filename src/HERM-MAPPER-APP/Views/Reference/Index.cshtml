@using HERMMapperApp
@using HERMMapperApp.Models
@using HERMMapperApp.ViewModels
@model ReferenceCatalogueViewModel
@{
    ViewData["Title"] = "HERM Browser";
    ViewData["BodyClass"] = "reference-browser-page";
    var isAdministrator = AppRoles.IsAdministrator(User);
    const string resultsAnchorId = "browser-results";
    var searchFormAction = $"{Url.Action("Index", "Reference")}#{resultsAnchorId}";
    var domainCount = Model.ModelGroups.Sum(group => group.Domains.Count);
    var capabilityCount = Model.ModelGroups.Sum(group => group.Domains.Sum(domain => domain.Capabilities.Count));
    var searchSummary = string.IsNullOrWhiteSpace(Model.Search) ? Model.SelectionTitle : $"Search: {Model.Search}";
}

<section class="page-header">
    <div>
        <span class="eyebrow">HERM Browser</span>
        <h1>Browse TRM, ARM, BRM, and DRM</h1>
        <p>Search across imported HERM models, then drill into model hierarchy selections from the browser tree.</p>
    </div>
</section>

<section class="stats-grid stats-grid-compact reference-browser-overview-grid">
    <article class="stat-card reference-browser-overview-card">
        <span class="stat-label">Model groups</span>
        <span class="stat-value">@Model.ModelGroups.Count</span>
        <span class="stat-meta">TRM, ARM, BRM, and DRM collections loaded</span>
    </article>
    <article class="stat-card reference-browser-overview-card">
        <span class="stat-label">Domains</span>
        <span class="stat-value">@domainCount</span>
        <span class="stat-meta">reference-model domains in navigation</span>
    </article>
    <article class="stat-card reference-browser-overview-card">
        <span class="stat-label">Capabilities</span>
        <span class="stat-value">@capabilityCount</span>
        <span class="stat-meta">capabilities exposed through the browser</span>
    </article>
    <article class="stat-card reference-browser-overview-card">
        <span class="stat-label">Visible results</span>
        <span class="stat-value">@Model.Components.Count</span>
        <span class="stat-meta">@searchSummary</span>
    </article>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ImportStatusMessage))
{
    <section class="content-card reference-browser-status-card">
        <div class="alert alert-success mb-0" role="status">
            @Model.ImportStatusMessage
        </div>
    </section>
}

<section class="content-card reference-browser-filter-card">
    <form method="get" action="@searchFormAction" class="row g-3 align-items-end reference-browser-filter-form">
        <div class="col-lg-9">
            <label class="form-label" for="search">Search browser</label>
            <input class="form-control"
                   id="search"
                   name="search"
                   value="@Model.Search"
                   placeholder="Model, topic type, topic, entity, description, or product example" />
        </div>
        <div class="col-lg-3 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit">Search</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </form>
</section>

<div class="browser-shell">
    <aside class="content-card browser-sidebar" id="browser-navigation">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Navigation</span>
                <h2>Reference tree</h2>
            </div>
        </div>

        <a class="browser-reset-link @((Model.SelectedModelKind is null && string.IsNullOrWhiteSpace(Model.SelectedDomainCode) && string.IsNullOrWhiteSpace(Model.SelectedCapabilityCode) && string.IsNullOrWhiteSpace(Model.SelectedComponentCode) && string.IsNullOrWhiteSpace(Model.SelectedSubClassCode)) ? "is-active" : null)"
           asp-action="Index"
           asp-route-search="@Model.Search"
           asp-fragment="browser-navigation">
            All models
        </a>

        @if (Model.ModelGroups.Count == 0)
        {
            <div class="empty-state compact">
                <h3>No imported models</h3>
                <p>Import a catalogue from Configuration to start browsing.</p>
            </div>
        }
        else
        {
            <ul class="browser-tree-root">
                @foreach (var group in Model.ModelGroups)
                {
                    var groupCss = group.ShortName.ToLowerInvariant();
                    <li class="browser-tree-item browser-tree-model browser-tree-@groupCss" id="@group.AnchorId">
                        <details class="browser-tree-details" @(group.IsExpanded ? "open" : null)>
                            <summary class="browser-tree-summary">
                                <a class="browser-tree-link browser-tree-link-strong @(group.IsSelected ? "is-active" : null)"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-modelKind="@group.ModelKind"
                                   asp-fragment="@resultsAnchorId">
                                    @group.Label
                                </a>
                                <span class="browser-tree-toggle" aria-hidden="true"></span>
                            </summary>

                            <div class="browser-tree-section-label">@group.DomainLabel</div>

                            <ul class="browser-tree-list">
                                @foreach (var domain in group.Domains)
                                {
                                    <li class="browser-tree-item browser-tree-domain browser-tree-@groupCss" id="@domain.AnchorId">
                                        @if (domain.Capabilities.Count == 0)
                                        {
                                            <div class="browser-tree-leaf-row">
                                                <a class="browser-tree-link @(domain.IsSelected ? "is-active" : null)"
                                                   asp-action="Index"
                                                   asp-route-search="@Model.Search"
                                                   asp-route-modelKind="@group.ModelKind"
                                                   asp-route-domainCode="@domain.Code"
                                                   asp-fragment="@resultsAnchorId">
                                                    @domain.DisplayLabel
                                                </a>
                                            </div>
                                        }
                                        else
                                        {
                                            <details class="browser-tree-details browser-tree-subtree" @(domain.IsExpanded ? "open" : null)>
                                                <summary class="browser-tree-summary browser-tree-summary-subtle">
                                                    <a class="browser-tree-link @(domain.IsSelected ? "is-active" : null)"
                                                       asp-action="Index"
                                                       asp-route-search="@Model.Search"
                                                       asp-route-modelKind="@group.ModelKind"
                                                       asp-route-domainCode="@domain.Code"
                                                       asp-fragment="@resultsAnchorId">
                                                        @domain.DisplayLabel
                                                    </a>
                                                    <span class="browser-tree-toggle" aria-hidden="true"></span>
                                                </summary>
                                                <ul class="browser-tree-list browser-tree-list-nested">
                                                    @foreach (var capability in domain.Capabilities)
                                                    {
                                                        <li class="browser-tree-item browser-tree-capability" id="@capability.AnchorId">
                                                            <div class="browser-tree-leaf-row browser-tree-leaf-row-subtle">
                                                                <a class="browser-tree-link @(capability.IsSelected ? "is-active" : null)"
                                                                   asp-action="Index"
                                                                   asp-route-search="@Model.Search"
                                                                   asp-route-modelKind="@group.ModelKind"
                                                                   asp-route-domainCode="@domain.Code"
                                                                   asp-route-capabilityCode="@capability.Code"
                                                                   asp-fragment="@resultsAnchorId">
                                                                    @capability.DisplayLabel
                                                                </a>
                                                            </div>
                                                            @if (capability.Components.Count != 0)
                                                            {
                                                                <ul class="browser-tree-list browser-tree-list-nested">
                                                                    @foreach (var entity in capability.Components)
                                                                    {
                                                                        <li class="browser-tree-item browser-tree-component" id="@entity.AnchorId">
                                                                            <a class="browser-tree-link @(entity.IsSelected ? "is-active" : null)"
                                                                               asp-action="Index"
                                                                               asp-route-search="@Model.Search"
                                                                               asp-route-modelKind="@group.ModelKind"
                                                                               asp-route-domainCode="@domain.Code"
                                                                               asp-route-capabilityCode="@capability.Code"
                                                                               asp-route-componentCode="@entity.Code"
                                                                               asp-fragment="@resultsAnchorId">
                                                                                @entity.DisplayLabel
                                                                            </a>
                                                                            @if (entity.Children.Count != 0)
                                                                            {
                                                                                <ul class="browser-tree-list browser-tree-list-nested">
                                                                                    @foreach (var subClass in entity.Children)
                                                                                    {
                                                                                        <li class="browser-tree-item browser-tree-component" id="@subClass.AnchorId">
                                                                                            <a class="browser-tree-link @(subClass.IsSelected ? "is-active" : null)"
                                                                                               asp-action="Index"
                                                                                               asp-route-search="@Model.Search"
                                                                                               asp-route-modelKind="@group.ModelKind"
                                                                                               asp-route-domainCode="@domain.Code"
                                                                                               asp-route-capabilityCode="@capability.Code"
                                                                                               asp-route-componentCode="@entity.Code"
                                                                                               asp-route-subClassCode="@subClass.Code"
                                                                                               asp-fragment="@resultsAnchorId">
                                                                                                @subClass.DisplayLabel
                                                                                            </a>
                                                                                        </li>
                                                                                    }
                                                                                </ul>
                                                                            }
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            </details>
                                        }
                                    </li>
                                }
                            </ul>
                        </details>
                    </li>
                }
            </ul>
        }
    </aside>

    <section class="content-card browser-results" id="@resultsAnchorId">
        <div class="section-heading browser-results-heading">
            <div>
                <span class="eyebrow">Selection</span>
                <h2>@Model.SelectionTitle</h2>
                <p class="browser-selection-copy">@Model.SelectionDescription</p>
            </div>
            @if (Model.SelectedModelKind.HasValue || !string.IsNullOrWhiteSpace(Model.SelectedDomainCode) || !string.IsNullOrWhiteSpace(Model.SelectedCapabilityCode) || !string.IsNullOrWhiteSpace(Model.SelectedComponentCode) || !string.IsNullOrWhiteSpace(Model.SelectedSubClassCode) || !string.IsNullOrWhiteSpace(Model.Search))
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Clear selection</a>
            }
        </div>

        @if (Model.Components.Count == 0)
        {
            <div class="empty-state compact">
                <h3>No matching results</h3>
                <p>Try a wider search or select another branch in the browser tree.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Model</th>
                            <th>Object</th>
                            <th>Capabilities</th>
                            <th>Domains</th>
                            <th>Details</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var component in Model.Components)
                    {
                        var modelCss = component.ModelLabel.ToLowerInvariant();
                        <tr>
                            <td>
                                <div class="browser-chip-row">
                                    <span class="browser-model-chip browser-model-chip-@modelCss">@component.ModelLabel</span>
                                    @if (component.IsCustom)
                                    {
                                        <span class="tag-pill tag-pill-custom">@component.TypeLabel</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <strong>@component.DisplayLabel</strong>
                                @if (!string.IsNullOrWhiteSpace(component.SecondaryCode))
                                {
                                    <div class="table-subline">@component.SecondaryCode</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(component.Description))
                                {
                                    <div class="table-subline">@component.Description</div>
                                }
                            </td>
                            <td>
                                @if (component.Capabilities.Count == 0)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <div class="mapping-chip-list">
                                        @foreach (var capability in component.Capabilities)
                                        {
                                            <span class="mapping-chip">@capability.DisplayLabel</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                @if (component.Domains.Count == 0)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <div class="mapping-chip-list">
                                        @foreach (var domain in component.Domains)
                                        {
                                            <span class="mapping-chip">@domain.DisplayLabel</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(component.ProductExamples) ? "-" : component.ProductExamples)</td>
                            <td class="text-end">
                                @if (component.SupportsHistory || (isAdministrator && component.SupportsDelete))
                                {
                                    <div class="table-action-group">
                                        @if (component.SupportsHistory)
                                        {
                                            <a class="table-action-button"
                                               asp-action="History"
                                               asp-route-id="@component.NativeId"
                                               title="Show history for @component.DisplayLabel"
                                               aria-label="Show history for @component.DisplayLabel">
                                                <partial name="_ActionIcon" model="@("history")" />
                                                <span class="visually-hidden">History</span>
                                            </a>
                                        }
                                        @if (isAdministrator && component.SupportsDelete)
                                        {
                                            <form asp-action="DeleteComponent" method="post" class="table-action-form">
                                                <input type="hidden" name="id" value="@component.NativeId" />
                                                <input type="hidden" name="modelKind" value="@component.ModelKind" />
                                                <button class="table-action-button table-action-button-danger"
                                                        type="submit"
                                                        title="Move @component.DisplayLabel to trash"
                                                        aria-label="Move @component.DisplayLabel to trash">
                                                    <partial name="_ActionIcon" model="@("trash")" />
                                                    <span class="visually-hidden">Trash</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
