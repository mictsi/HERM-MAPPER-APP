@using HERMMapperApp.Services
@model ReferenceRestoreViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["AdminNav"] = Model.AdminNavKey;
    ViewData["BodyClass"] = "admin-page restore-page reference-restore-page";
    var historyCount = Model.Components.Count(component => component.SupportsHistory);
    var reasonCount = Model.Components.Count(component => !string.IsNullOrWhiteSpace(component.DeletedReason));
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <section class="page-header">
            <div>
                <span class="eyebrow">@Model.Eyebrow</span>
                <h1>@Model.Heading</h1>
                <p>@Model.Description</p>
            </div>
        </section>

        <section class="stats-grid stats-grid-compact admin-overview-grid">
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Deleted components</span>
                <span class="stat-value">@Model.Components.Count</span>
                <span class="stat-meta">items available to restore</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">History support</span>
                <span class="stat-value">@historyCount</span>
                <span class="stat-meta">items with version history</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Deleted reasons</span>
                <span class="stat-value">@reasonCount</span>
                <span class="stat-meta">items carrying a recorded reason</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Model scope</span>
                <span class="stat-value details-overview-value-small">@Model.Heading</span>
                <span class="stat-meta">reference-model restore workspace</span>
            </article>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <section class="content-card">
                <div class="alert alert-success mb-0">@Model.StatusMessage</div>
            </section>
        }

        <section class="content-card">
            @if (Model.Components.Count == 0)
            {
                <div class="empty-state compact">
                    <h3>@Model.EmptyHeading</h3>
                    <p>@Model.EmptyDescription</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Component</th>
                                <th>Capabilities</th>
                                <th>Deleted</th>
                                <th>Reason</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var component in Model.Components)
                        {
                            <tr>
                                <td>@component.DisplayLabel</td>
                                <td>@component.CapabilitiesText</td>
                                <td>@await TimeZoneDisplay.FormatUtcAsync(component.DeletedUtc)</td>
                                <td>@(component.DeletedReason ?? "-")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (component.SupportsHistory)
                                        {
                                            <a class="btn btn-outline-secondary" asp-action="History" asp-route-id="@component.Id">History</a>
                                        }
                                        <form asp-action="RestoreComponent" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@component.Id" />
                                            <input type="hidden" name="modelKind" value="@component.ModelKind" />
                                            <button class="btn btn-outline-primary" type="submit">Restore</button>
                                        </form>
                                        <form asp-action="PermanentlyDeleteComponent" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this component?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@component.Id" />
                                            <input type="hidden" name="modelKind" value="@component.ModelKind" />
                                            <button class="btn btn-outline-danger" type="submit">Delete forever</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
