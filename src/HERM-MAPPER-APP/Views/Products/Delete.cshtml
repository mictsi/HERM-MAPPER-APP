@model ProductCatalogItem
@{
    ViewData["Title"] = "Trash Product";
    ViewData["BodyClass"] = "products-page confirmation-page product-delete-page";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Catalogue CRUD</span>
        <h1>Move @Model.Name to trash?</h1>
        <p>This hides the product from the catalogue. Administrators can restore it or permanently delete it later from Admin.</p>
    </div>
</section>

<section class="stats-grid stats-grid-compact details-overview-grid">
    <article class="stat-card details-overview-card">
        <span class="stat-label">Product</span>
        <span class="stat-value details-overview-value-small">@Model.Name</span>
        <span class="stat-meta">catalogue record selected for trash</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Vendor</span>
        <span class="stat-value details-overview-value-small">@(string.IsNullOrWhiteSpace(Model.Vendor) ? "Unset" : Model.Vendor)</span>
        <span class="stat-meta">current vendor label on the record</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Mappings</span>
        <span class="stat-value">@Model.Mappings.Count</span>
        <span class="stat-meta">TRM links preserved while the record is trashed</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Outcome</span>
        <span class="stat-value details-overview-value-small">Recoverable</span>
        <span class="stat-meta">admins can restore or permanently delete later</span>
    </article>
</section>

<section class="row g-4 confirmation-shell">
    <div class="col-xl-8">
        <section class="content-card confirmation-main-card mb-0">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Record review</span>
                    <h2>Catalogue details</h2>
                </div>
            </div>
            <dl class="detail-grid mb-0">
                <dt>Product</dt>
                <dd>@Model.Name</dd>
                <dt>Vendor</dt>
                <dd>@(Model.Vendor ?? "-")</dd>
                <dt>Mappings</dt>
                <dd>@Model.Mappings.Count</dd>
            </dl>
        </section>
    </div>
    <div class="col-xl-4">
        <aside class="content-card confirmation-side-card mb-0">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Action</span>
                    <h2>Send to trash</h2>
                </div>
            </div>
            <div class="confirmation-note mb-3">
                The product disappears from the active catalogue but remains available in the Admin restore tools until it is permanently deleted.
            </div>
            <form asp-action="Delete" method="post" class="d-grid gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Move to trash</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </form>
        </aside>
    </div>
</section>
