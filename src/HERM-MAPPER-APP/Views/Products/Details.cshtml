@using System.Text.Json
@using HERMMapperApp
@using HERMMapperApp.Models
@using HERMMapperApp.Services
@using HERMMapperApp.ViewModels
@model ProductVisualizationViewModel
@{
    ViewData["Title"] = "Product Details";
    var canManageProductsAndServices = AppRoles.CanManageProductsAndServices(User);
    var isAdministrator = AppRoles.IsAdministrator(User);
    var product = Model.Product;
    var hierarchyData = JsonSerializer.Serialize(
        Model.HierarchyRoot,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

<section class="page-header">
    <div>
        <span class="eyebrow">Catalogue record</span>
        <h1>@product.Name</h1>
        <p>@product.Vendor @product.Version</p>
    </div>
    <div class="d-flex gap-2">
        @if (isAdministrator)
        {
        <a class="btn btn-primary" asp-controller="Mappings" asp-action="Create" asp-route-productId="@product.Id">Add mapping</a>
        }
        <a class="btn btn-outline-secondary" asp-action="Visualize" asp-route-id="@product.Id">Visualize</a>
        <a class="btn btn-outline-secondary" asp-action="ShowDependencies" asp-route-id="@product.Id">Show dependencies</a>
        @if (canManageProductsAndServices)
        {
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@product.Id">Edit product</a>
        }
    </div>
</section>

<section class="content-card mb-4">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Product metadata</span>
            <h2>Details</h2>
        </div>
    </div>
    <dl class="detail-grid">
        <dt>Vendor</dt>
        <dd>@(product.Vendor ?? "-")</dd>
        <dt>Version</dt>
        <dd>@(product.Version ?? "-")</dd>
        <dt>Owners</dt>
        <dd>@(product.OwnerDisplay ?? "-")</dd>
        <dt>Lifecycle</dt>
        <dd>@(product.LifecycleStatus ?? "-")</dd>
        <dt>Description</dt>
        <dd>@(product.Description ?? "-")</dd>
        <dt>Notes</dt>
        <dd>@(product.Notes ?? "-")</dd>
    </dl>
</section>

<section class="content-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">HERM alignment</span>
            <h2>@product.Mappings.Count mapping(s)</h2>
        </div>
    </div>

    @if (product.Mappings.Count == 0)
    {
        <div class="empty-state compact">
            <h3>No mappings yet</h3>
            <p>Create the first HERM TRM relationship for this product.</p>
        </div>
    }
    else
    {
        <div class="mapping-flow-list mb-4">
            @foreach (var mapping in product.Mappings.OrderBy(x => x.TrmDomain?.Name ?? string.Empty).ThenBy(x => x.TrmComponent?.Name ?? string.Empty))
            {
                var capability = mapping.TrmComponent?.ParentCapability ?? mapping.TrmCapability;
                var domain = mapping.TrmComponent?.ParentCapability?.ParentDomain ?? capability?.ParentDomain ?? mapping.TrmDomain;
                <article class="mapping-flow-card">
                    <div class="mapping-node">
                        <span class="eyebrow text-dark">Domain</span>
                        <strong>@(domain is null ? "-" : $"{domain.Code} {domain.Name}")</strong>
                    </div>
                    <div class="mapping-flow-arrow">→</div>
                    <div class="mapping-node">
                        <span class="eyebrow text-dark">Capability</span>
                        <strong>@(capability is null ? "-" : $"{capability.Code} {capability.Name}")</strong>
                    </div>
                    <div class="mapping-flow-arrow">→</div>
                    <div class="mapping-node">
                        <span class="eyebrow text-dark">Component</span>
                        <strong>@(mapping.TrmComponent is null ? "-" : mapping.TrmComponent.DisplayLabel)</strong>
                    </div>
                    <div class="mapping-flow-arrow">→</div>
                    <div class="mapping-node">
                        <span class="eyebrow text-dark">Product</span>
                        <strong>@product.Name</strong>
                    </div>
                </article>
            }
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Domain</th>
                        <th>Capability</th>
                        <th>Component</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var mapping in product.Mappings.OrderBy(x => x.TrmDomain?.Name ?? string.Empty).ThenBy(x => x.TrmComponent?.Name ?? string.Empty))
                {
                    var capability = mapping.TrmComponent?.ParentCapability ?? mapping.TrmCapability;
                    var domain = mapping.TrmComponent?.ParentCapability?.ParentDomain ?? capability?.ParentDomain ?? mapping.TrmDomain;
                    <tr>
                        <td><span class="status-pill status-@mapping.MappingStatus.ToString().ToLowerInvariant()">@mapping.MappingStatus</span></td>
                        <td>@(domain is null ? "-" : $"{domain.Code} {domain.Name}")</td>
                        <td>@(capability is null ? "-" : $"{capability.Code} {capability.Name}")</td>
                        <td>@(mapping.TrmComponent is null ? "-" : mapping.TrmComponent.DisplayLabel)</td>
                        <td class="text-end">
                            @if (isAdministrator)
                            {
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-controller="Mappings" asp-action="Edit" asp-route-id="@mapping.Id">Modify mapping</a>
                                <a class="btn btn-outline-danger" asp-controller="Mappings" asp-action="Delete" asp-route-id="@mapping.Id">Delete</a>
                            </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="content-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Hierarchy</span>
            <h2>Product dependency map</h2>
        </div>
    </div>

    @if (!Model.HasResolvedPaths)
    {
        <div class="empty-state compact">
            <h3>No dependency map yet</h3>
            <p>Create at least one TRM mapping to build the product dependency tree.</p>
        </div>
    }
    else
    {
        <div class="application-radial-tree-shell" data-application-radial-tree-shell>
            <div class="application-radial-tree-toolbar">
                <button type="button"
                        class="application-radial-tree-fullscreen-button"
                        data-application-radial-tree-fullscreen
                        aria-label="Enter full screen"
                        title="Enter full screen">
                    <span class="application-radial-tree-fullscreen-icon" aria-hidden="true"></span>
                    <span data-application-radial-tree-fullscreen-label>Full screen</span>
                </button>
            </div>
            <script type="application/json" data-application-radial-tree-data>@Html.Raw(hierarchyData)</script>
            <div class="application-radial-tree"
                 data-application-radial-tree
                 data-include-products="true"
                 data-empty-title="No dependency map yet"
                 data-empty-body="Create at least one TRM mapping to build the product dependency tree."></div>
            <p class="application-radial-tree-note">Drag to pan and use the mouse wheel to zoom. The tree reads from left to right, starting with the product and expanding into its mapped TRM domain, capability, and component routes.</p>
        </div>
    }
</section>

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/application-radial-tree.js" asp-append-version="true"></script>
}
