@using System.Text.Json
@using HERMMapperApp
@using HERMMapperApp.Models
@using HERMMapperApp.Services
@using HERMMapperApp.ViewModels
@model ProductVisualizationViewModel
@{
    ViewData["Title"] = "Product Details";
    ViewData["BodyClass"] = "products-page products-details-page";
    var canManageProductsAndServices = AppRoles.CanManageProductsAndServices(User);
    var isAdministrator = AppRoles.IsAdministrator(User);
    var product = Model.Product;
    var ownerCount = product.GetOwnerValues().Count;
    var lifecycleLabel = string.IsNullOrWhiteSpace(product.LifecycleStatus) ? "Unset" : product.LifecycleStatus;
    var hierarchyData = JsonSerializer.Serialize(
        Model.HierarchyRoot,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

<section class="page-header">
    <div>
        <span class="eyebrow">Catalogue record</span>
        <h1>@product.Name</h1>
        <p>@product.Vendor @product.Version</p>
    </div>
    <div class="d-flex gap-2 product-details-page-actions">
        @if (isAdministrator)
        {
        <a class="btn btn-primary product-details-icon-button"
           asp-controller="Mappings"
           asp-action="Create"
           asp-route-productId="@product.Id"
           aria-label="Add mapping"
           title="Add mapping">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M8 3.25v9.5"></path>
                <path d="M3.25 8h9.5"></path>
            </svg>
        </a>
        }
        <a class="btn btn-outline-secondary product-details-icon-button"
           asp-action="Visualize"
           asp-route-id="@product.Id"
           aria-label="Visualize"
           title="Visualize">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <circle cx="3.25" cy="8" r="1.35"></circle>
                <circle cx="8" cy="3.25" r="1.35"></circle>
                <circle cx="12.75" cy="8" r="1.35"></circle>
                <circle cx="8" cy="12.75" r="1.35"></circle>
                <path d="M4.35 7.15 6.95 4.35"></path>
                <path d="M9.05 4.35 11.65 7.15"></path>
                <path d="M11.65 8.85 9.05 11.65"></path>
                <path d="M6.95 11.65 4.35 8.85"></path>
            </svg>
        </a>
        <a class="btn btn-outline-secondary product-details-icon-button"
           asp-action="ShowDependencies"
           asp-route-id="@product.Id"
           aria-label="Show dependencies"
           title="Show dependencies">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <rect x="2.25" y="2.5" width="3.5" height="3.25" rx="0.7"></rect>
                <rect x="10.25" y="2.5" width="3.5" height="3.25" rx="0.7"></rect>
                <rect x="6.25" y="10.25" width="3.5" height="3.25" rx="0.7"></rect>
                <path d="M5.75 4.125h4.5"></path>
                <path d="M8 5.75v4.5"></path>
            </svg>
        </a>
        @if (canManageProductsAndServices)
        {
        <a class="btn btn-outline-secondary product-details-icon-button"
           asp-action="Edit"
           asp-route-id="@product.Id"
           aria-label="Edit product"
           title="Edit product">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M3 13h2.6l6.2-6.2-2.6-2.6L3 10.4V13Z"></path>
                <path d="m8.85 4.15 2.6 2.6"></path>
                <path d="M2.75 13.25h10.5"></path>
            </svg>
        </a>
        }
    </div>
</section>

<section class="stats-grid stats-grid-compact details-overview-grid">
    <article class="stat-card details-overview-card">
        <span class="stat-label">Mappings</span>
        <span class="stat-value">@product.Mappings.Count</span>
        <span class="stat-meta">TRM relationships on this product</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Owners</span>
        <span class="stat-value">@ownerCount</span>
        <span class="stat-meta">assigned to this catalogue record</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Resolved paths</span>
        <span class="stat-value">@Model.Paths.Count</span>
        <span class="stat-meta">dependency routes available</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Lifecycle</span>
        <span class="stat-value details-overview-value-small">@lifecycleLabel</span>
        <span class="stat-meta">current product state</span>
    </article>
</section>

<section class="content-card mb-4 details-primary-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Product metadata</span>
            <h2>Details</h2>
        </div>
    </div>
    <dl class="detail-grid">
        <dt>Vendor</dt>
        <dd>@(product.Vendor ?? "-")</dd>
        <dt>Version</dt>
        <dd>@(product.Version ?? "-")</dd>
        <dt>Owners</dt>
        <dd>@(product.OwnerDisplay ?? "-")</dd>
        <dt>Lifecycle</dt>
        <dd>@(product.LifecycleStatus ?? "-")</dd>
        <dt>Description</dt>
        <dd>@(product.Description ?? "-")</dd>
        <dt>Notes</dt>
        <dd>@(product.Notes ?? "-")</dd>
    </dl>
</section>

<section class="content-card details-primary-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">HERM alignment</span>
            <h2>@product.Mappings.Count mapping(s)</h2>
        </div>
    </div>

    @if (product.Mappings.Count == 0)
    {
        <div class="empty-state compact">
            <h3>No mappings yet</h3>
            <p>Create the first HERM TRM relationship for this product.</p>
        </div>
    }
    else
    {
        <div class="mapping-flow-list mb-4">
            @foreach (var mapping in product.Mappings.OrderBy(x => x.TrmDomain?.Name ?? string.Empty).ThenBy(x => x.TrmComponent?.Name ?? string.Empty))
            {
                var capability = mapping.TrmComponent?.ParentCapability ?? mapping.TrmCapability;
                var domain = mapping.TrmComponent?.ParentCapability?.ParentDomain ?? capability?.ParentDomain ?? mapping.TrmDomain;
                <article class="mapping-flow-card">
                    <div class="mapping-node">
                        <span class="eyebrow text-dark">Domain</span>
                        <strong>@(domain is null ? "-" : $"{domain.Code} {domain.Name}")</strong>
                    </div>
                    <div class="mapping-flow-arrow">→</div>
                    <div class="mapping-node">
                        <span class="eyebrow text-dark">Capability</span>
                        <strong>@(capability is null ? "-" : $"{capability.Code} {capability.Name}")</strong>
                    </div>
                    <div class="mapping-flow-arrow">→</div>
                    <div class="mapping-node">
                        <span class="eyebrow text-dark">Component</span>
                        <strong>@(mapping.TrmComponent is null ? "-" : mapping.TrmComponent.DisplayLabel)</strong>
                    </div>
                    <div class="mapping-flow-arrow">→</div>
                    <div class="mapping-node">
                        <span class="eyebrow text-dark">Product</span>
                        <strong>@product.Name</strong>
                    </div>
                </article>
            }
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Domain</th>
                        <th>Capability</th>
                        <th>Component</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var mapping in product.Mappings.OrderBy(x => x.TrmDomain?.Name ?? string.Empty).ThenBy(x => x.TrmComponent?.Name ?? string.Empty))
                {
                    var capability = mapping.TrmComponent?.ParentCapability ?? mapping.TrmCapability;
                    var domain = mapping.TrmComponent?.ParentCapability?.ParentDomain ?? capability?.ParentDomain ?? mapping.TrmDomain;
                    <tr>
                        <td><span class="status-pill status-@mapping.MappingStatus.ToString().ToLowerInvariant()">@mapping.MappingStatus</span></td>
                        <td>@(domain is null ? "-" : $"{domain.Code} {domain.Name}")</td>
                        <td>@(capability is null ? "-" : $"{capability.Code} {capability.Name}")</td>
                        <td>@(mapping.TrmComponent is null ? "-" : mapping.TrmComponent.DisplayLabel)</td>
                        <td class="text-end">
                            @if (isAdministrator)
                            {
                            <div class="btn-group btn-group-sm product-details-table-actions">
                                <a class="btn btn-outline-secondary product-details-icon-button product-details-icon-button-sm"
                                   asp-controller="Mappings"
                                   asp-action="Edit"
                                   asp-route-id="@mapping.Id"
                                   aria-label="Modify mapping"
                                   title="Modify mapping">
                                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M3 13h2.6l6.2-6.2-2.6-2.6L3 10.4V13Z"></path>
                                        <path d="m8.85 4.15 2.6 2.6"></path>
                                        <path d="M2.75 13.25h10.5"></path>
                                    </svg>
                                </a>
                                <a class="btn btn-outline-danger product-details-icon-button product-details-icon-button-sm"
                                   asp-controller="Mappings"
                                   asp-action="Delete"
                                   asp-route-id="@mapping.Id"
                                   aria-label="Delete mapping"
                                   title="Delete mapping">
                                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M3.5 4.5h9"></path>
                                        <path d="M6.25 2.75h3.5"></path>
                                        <path d="M5 4.5v7.25"></path>
                                        <path d="M8 4.5v7.25"></path>
                                        <path d="M11 4.5v7.25"></path>
                                        <path d="M4.5 4.5l.55 8.1c.04.55.49.97 1.04.97h3.82c.55 0 1-.42 1.04-.97l.55-8.1"></path>
                                    </svg>
                                </a>
                            </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="content-card details-primary-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Hierarchy</span>
            <h2>Product dependency map</h2>
        </div>
    </div>

    @if (!Model.HasResolvedPaths)
    {
        <div class="empty-state compact">
            <h3>No dependency map yet</h3>
            <p>Create at least one TRM mapping to build the product dependency tree.</p>
        </div>
    }
    else
    {
        <div class="application-radial-tree-shell" data-application-radial-tree-shell>
            <div class="application-radial-tree-toolbar">
                <button type="button"
                        class="application-radial-tree-fullscreen-button"
                        data-application-radial-tree-fullscreen
                        aria-label="Enter full screen"
                        title="Enter full screen">
                    <span class="application-radial-tree-fullscreen-icon" aria-hidden="true"></span>
                    <span data-application-radial-tree-fullscreen-label>Full screen</span>
                </button>
            </div>
            <script type="application/json" data-application-radial-tree-data>@Html.Raw(hierarchyData)</script>
            <div class="application-radial-tree"
                 data-application-radial-tree
                 data-include-products="true"
                 data-empty-title="No dependency map yet"
                 data-empty-body="Create at least one TRM mapping to build the product dependency tree."></div>
            <p class="application-radial-tree-note">Drag to pan and use the mouse wheel to zoom. The tree reads from left to right, starting with the product and expanding into its mapped TRM domain, capability, and component routes.</p>
        </div>
    }
</section>

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/application-radial-tree.js" asp-append-version="true"></script>
}
