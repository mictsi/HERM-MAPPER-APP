@model ProductEditViewModel
@{
    ViewData["Title"] = "Add Product";
    ViewData["BodyClass"] = "products-page products-editor-page";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Catalogue CRUD</span>
        <h1>Add a product</h1>
        <p>Create the catalogue item first, then assign one or more HERM mappings.</p>
    </div>
</section>

<form asp-action="Create" method="post" class="editor-form-shell">
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
