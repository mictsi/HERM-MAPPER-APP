@model UserResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    ViewData["AdminNav"] = "Users";
    ViewData["BodyClass"] = "admin-page admin-crud-page users-reset-password-page";
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <section class="page-header">
            <div>
                <span class="eyebrow">Administration</span>
                <h1>Reset password</h1>
                <p>@Model.DisplayName (@Model.UserName)</p>
            </div>
        </section>

        <section class="stats-grid stats-grid-compact admin-overview-grid">
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Account</span>
                <span class="stat-value details-overview-value-small">@Model.DisplayName</span>
                <span class="stat-meta">local user receiving new credentials</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Username</span>
                <span class="stat-value details-overview-value-small">@Model.UserName</span>
                <span class="stat-meta">sign-in identifier for the reset</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Password fields</span>
                <span class="stat-value">2</span>
                <span class="stat-meta">new password entry and confirmation</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Scope</span>
                <span class="stat-value details-overview-value-small">Credentials only</span>
                <span class="stat-meta">identity and role remain unchanged</span>
            </article>
        </section>

        <form asp-action="ResetPassword" method="post" class="editor-form-shell">
            <section class="row g-4 editor-panel-grid">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="col-xl-8">
                    <section class="content-card editor-main-card mb-0">
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">Credential reset</span>
                                <h2>Issue a new password</h2>
                                <p>Create a replacement password for this local account without changing any other profile data.</p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-6" data-password-strength-root>
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" data-password-input />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <div class="password-strength mt-3">
                                    <div class="password-strength-track">
                                        <div class="password-strength-bar" data-password-strength-bar data-strength-tone="weak"></div>
                                    </div>
                                    <div class="password-strength-label" data-password-strength-label>Weak</div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col-xl-4">
                    <aside class="content-card editor-side-card h-100 mb-0">
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">Workflow</span>
                                <h2>After reset</h2>
                            </div>
                        </div>
                        <div class="confirmation-note mb-3">
                            The previous password stops working immediately after you save the replacement credential.
                        </div>
                        <ul class="confirmation-list mb-4">
                            <li>Use a strong temporary password and share it through a secure channel.</li>
                            <li>Identity, email, username, and role are not changed here.</li>
                            <li>Return to Users to review or update the account record afterward.</li>
                        </ul>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary" type="submit">Save password</button>
                            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                        </div>
                    </aside>
                </div>
            </section>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}