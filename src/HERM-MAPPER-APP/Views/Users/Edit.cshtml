@model UserUpdateViewModel
@{
    ViewData["Title"] = "Edit user";
    ViewData["AdminNav"] = "Users";
    ViewData["BodyClass"] = "admin-page admin-crud-page users-edit-page";
    var roleOptionCount = Model.RoleOptions.Count;
    var userId = Model.Id ?? 0;
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <section class="page-header">
                <p>Update profile details and role assignment for this local workspace account.</p>
            <div>
                <span class="eyebrow">Administration</span>
                <h1>Edit user</h1>
        <section class="stats-grid stats-grid-compact admin-overview-grid">
            <article class="stat-card admin-overview-card">
                <span class="stat-label">User record</span>
                <span class="stat-value">@userId</span>
                <span class="stat-meta">local account identifier</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Role options</span>
                <span class="stat-value">@roleOptionCount</span>
                <span class="stat-meta">roles available for reassignment</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Credentials</span>
                <span class="stat-value details-overview-value-small">Managed separately</span>
                <span class="stat-meta">password changes stay on the reset-password screen</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Username</span>
                <span class="stat-value details-overview-value-small">@Model.UserName</span>
                <span class="stat-meta">sign-in identity for this account</span>
            </article>
        </section>

        <form asp-action="Edit" method="post" class="editor-form-shell">
            <section class="row g-4 editor-panel-grid">

        <section class="content-card">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="col-xl-8">
                    <section class="content-card editor-main-card mb-0">
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">Local account</span>
                                <h2>Profile and permissions</h2>
                                <p>Change identity details or move the user between workspace roles without affecting their password.</p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-6">
                                <label asp-for="GivenName" class="form-label"></label>
                                <input asp-for="GivenName" class="form-control" />
                                <span asp-validation-for="GivenName" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="UserName" class="form-label"></label>
                                <input asp-for="UserName" class="form-control" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="RoleName" class="form-label"></label>
                                <select asp-for="RoleName" asp-items="Model.RoleOptions" class="form-select"></select>
                                <span asp-validation-for="RoleName" class="text-danger small"></span>
                            </div>
                        </div>
                    </section>
                <div class="col-12 d-flex justify-content-end gap-2">
                <div class="col-xl-4">
                    <aside class="content-card editor-side-card h-100 mb-0">
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">Workflow</span>
                                <h2>Update scope</h2>
                            </div>
                        </div>
                        <div class="confirmation-note mb-3">
                            Saving here updates the local identity record only. Use Reset password if the user also needs new credentials.
                        </div>
                        <ul class="confirmation-list mb-4">
                            <li>Review role changes carefully before saving administrative access.</li>
                            <li>Keep the username aligned with the user’s login expectation.</li>
                            <li>Email changes affect recovery and contact workflows.</li>
                        </ul>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary" type="submit">Save user</button>
                            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                        </div>
                    </aside>
                </div>
            </section>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}