@model UserEditViewModel
@{
    ViewData["Title"] = "Create user";
    ViewData["AdminNav"] = "Users";
    ViewData["BodyClass"] = "admin-page admin-crud-page users-create-page";
    var roleOptionCount = Model.RoleOptions.Count;
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <section class="page-header">
            <div>
                <span class="eyebrow">Administration</span>
                <h1>Create user</h1>
                <p>Add a local workspace account, assign its role, and issue its starting password from the same workflow.</p>
            </div>
        </section>

        <section class="stats-grid stats-grid-compact admin-overview-grid">
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Role choices</span>
                <span class="stat-value">@roleOptionCount</span>
                <span class="stat-meta">workspace roles available for assignment</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Profile fields</span>
                <span class="stat-value">4</span>
                <span class="stat-meta">name, email, username, and role</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Credential steps</span>
                <span class="stat-value">2</span>
                <span class="stat-meta">password entry plus confirmation</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Account type</span>
                <span class="stat-value details-overview-value-small">Local user</span>
                <span class="stat-meta">created directly inside the HERM workspace</span>
            </article>
        </section>

        <form asp-action="Create" method="post" class="editor-form-shell">
            <section class="row g-4 editor-panel-grid">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="col-xl-8">
                    <section class="content-card editor-main-card mb-0">
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">Local account</span>
                                <h2>Identity and access</h2>
                                <p>Enter the user profile and assign the initial workspace role before issuing credentials.</p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-6">
                                <label asp-for="GivenName" class="form-label"></label>
                                <input asp-for="GivenName" class="form-control" />
                                <span asp-validation-for="GivenName" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="UserName" class="form-label"></label>
                                <input asp-for="UserName" class="form-control" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="RoleName" class="form-label"></label>
                                <select asp-for="RoleName" asp-items="Model.RoleOptions" class="form-select"></select>
                                <span asp-validation-for="RoleName" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6" data-password-strength-root>
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" data-password-input />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <div class="password-strength mt-3">
                                    <div class="password-strength-track">
                                        <div class="password-strength-bar" data-password-strength-bar data-strength-tone="weak"></div>
                                    </div>
                                    <div class="password-strength-label" data-password-strength-label>Weak</div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col-xl-4">
                    <aside class="content-card editor-side-card h-100 mb-0">
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">Workflow</span>
                                <h2>Before you save</h2>
                            </div>
                        </div>
                        <div class="confirmation-note mb-3">
                            Local accounts can sign in immediately after creation. Choose the least-privileged role that matches the user’s expected work.
                        </div>
                        <ul class="confirmation-list mb-4">
                            <li>Use the email and username the person will actually use to sign in.</li>
                            <li>Share the initial password through a secure channel after creation.</li>
                            <li>Password resets remain available from the Users workspace.</li>
                        </ul>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary" type="submit">Create user</button>
                            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                        </div>
                    </aside>
                </div>
            </section>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}