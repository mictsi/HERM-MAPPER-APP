@model UsersIndexViewModel
@{
    ViewData["Title"] = "Users";
    ViewData["AdminNav"] = "Users";
    ViewData["BodyClass"] = "admin-page users-page";
    var pageStart = Math.Max(1, Model.Page - 2);
    var pageEnd = Math.Min(Model.TotalPages, Model.Page + 2);
    var roleCount = Model.Users
        .Select(user => user.RoleName)
        .Where(role => !string.IsNullOrWhiteSpace(role))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <section class="page-header">
            <div>
                <span class="eyebrow">Administration</span>
                <h1>Users</h1>
                <p>Create, update, delete, and reset passwords for local application users.</p>
            </div>
            <a class="btn btn-primary" asp-action="Create">Create user</a>
        </section>

        <section class="stats-grid stats-grid-compact admin-overview-grid">
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Total users</span>
                <span class="stat-value">@Model.TotalCount</span>
                <span class="stat-meta">local application accounts</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Visible users</span>
                <span class="stat-value">@Model.Users.Count</span>
                <span class="stat-meta">records on the current page</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Roles in view</span>
                <span class="stat-value">@roleCount</span>
                <span class="stat-meta">distinct roles on this page</span>
            </article>
            <article class="stat-card admin-overview-card">
                <span class="stat-label">Pagination</span>
                <span class="stat-value">@Model.Page / @Model.TotalPages</span>
                <span class="stat-meta">@(string.IsNullOrWhiteSpace(Model.Search) ? "all users" : $"search: {Model.Search}")</span>
            </article>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <section class="content-card">
                <div class="alert alert-success mb-0">@Model.StatusMessage</div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <section class="content-card">
                <div class="alert alert-danger mb-0">@Model.ErrorMessage</div>
            </section>
        }

        <section class="content-card">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-lg-10">
                    <label class="form-label" for="search">Search users</label>
                    <input class="form-control"
                           id="search"
                           name="search"
                           value="@Model.Search"
                           placeholder="Name, email, username, or role" />
                </div>
                <div class="col-lg-2 d-grid">
                    <button class="btn btn-primary" type="submit">Search</button>
                </div>
            </form>
        </section>

        <section class="content-card">
            @if (Model.TotalCount == 0)
            {
                <div class="empty-state compact">
                    <h3>@(string.IsNullOrWhiteSpace(Model.Search) ? "No users" : "No matching users")</h3>
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Search)
                            ? "Create the first user account."
                            : "Try a broader search term.")
                    </p>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                    <div class="table-subline">
                        Showing @Model.FirstItemNumber-@Model.LastItemNumber of @Model.TotalCount users
                    </div>
                    @if (Model.TotalPages > 1)
                    {
                        <div class="table-subline">Page @Model.Page of @Model.TotalPages</div>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Password changed</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.DisplayName</td>
                                <td>@user.Email</td>
                                <td>@user.UserName</td>
                                <td>@user.RoleName</td>
                                <td>@await TimeZoneDisplay.FormatUtcAsync(user.PasswordChangedUtc)</td>
                                <td class="text-end">
                                    <div class="table-action-group">
                                        <a class="table-action-button"
                                           asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           title="Edit @user.DisplayName"
                                           aria-label="Edit @user.DisplayName">
                                            <partial name="_ActionIcon" model="@("edit")" />
                                            <span class="visually-hidden">Edit</span>
                                        </a>
                                        <a class="table-action-button"
                                           asp-action="ResetPassword"
                                           asp-route-id="@user.Id"
                                           title="Reset password for @user.DisplayName"
                                           aria-label="Reset password for @user.DisplayName">
                                            <partial name="_ActionIcon" model="@("reset-password")" />
                                            <span class="visually-hidden">Reset password</span>
                                        </a>
                                        <a class="table-action-button table-action-button-danger"
                                           asp-action="Delete"
                                           asp-route-id="@user.Id"
                                           title="Delete @user.DisplayName"
                                           aria-label="Delete @user.DisplayName">
                                            <partial name="_ActionIcon" model="@("trash")" />
                                            <span class="visually-hidden">Delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Users pagination" class="mt-3">
                        <ul class="pagination mb-0 flex-wrap">
                            <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@(Model.Page - 1)">Previous</a>
                            </li>
                            @for (var pageNumber = pageStart; pageNumber <= pageEnd; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.Page ? "active" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@Model.Search"
                                       asp-route-page="@pageNumber">@pageNumber</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-page="@(Model.Page + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </section>
    </div>
</div>
