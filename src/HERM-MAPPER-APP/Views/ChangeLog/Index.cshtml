@model ChangeLogIndexViewModel
@{
    ViewData["Title"] = "Change Log";
    ViewData["AdminNav"] = "ChangeLog";
    ViewData["BodyClass"] = "admin-page changelog-page";
    var actorCount = Model.Entries
        .Select(entry => entry.ActorUserName)
        .Where(actor => !string.IsNullOrWhiteSpace(actor))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    var categoryCount = Model.Entries
        .Select(entry => entry.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
<section class="page-header">
    <div>
        <span class="eyebrow">Operations audit</span>
        <h1>Central changelog</h1>
        <p>Search imports, component changes, product updates, and mapping activity.</p>
    </div>
</section>

<section class="stats-grid stats-grid-compact admin-overview-grid">
    <article class="stat-card admin-overview-card">
        <span class="stat-label">Visible entries</span>
        <span class="stat-value">@Model.Entries.Count</span>
        <span class="stat-meta">audit rows in this result set</span>
    </article>
    <article class="stat-card admin-overview-card">
        <span class="stat-label">Actors</span>
        <span class="stat-value">@actorCount</span>
        <span class="stat-meta">distinct users represented</span>
    </article>
    <article class="stat-card admin-overview-card">
        <span class="stat-label">Categories</span>
        <span class="stat-value">@categoryCount</span>
        <span class="stat-meta">audit categories in view</span>
    </article>
    <article class="stat-card admin-overview-card">
        <span class="stat-label">Search</span>
        <span class="stat-value details-overview-value-small">@(string.IsNullOrWhiteSpace(Model.Search) ? "All entries" : Model.Search)</span>
        <span class="stat-meta">current changelog scope</span>
    </article>
</section>

<section class="content-card">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-lg-10">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="User, category, action, entity, summary, or details" />
        </div>
        <div class="col-lg-2 d-grid">
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </form>
</section>

<section class="content-card">
    @if (Model.Entries.Count == 0)
    {
        <div class="empty-state compact">
            <h3>No matching entries</h3>
            <p>Try a broader search term.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>User</th>
                        <th>Category</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Summary</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td>@await TimeZoneDisplay.FormatUtcAsync(entry.OccurredUtc)</td>
                        <td>@(string.IsNullOrWhiteSpace(entry.ActorUserName) ? "-" : entry.ActorUserName)</td>
                        <td>@entry.Category</td>
                        <td>@entry.Action</td>
                        <td>@(entry.EntityType is null ? "-" : $"{entry.EntityType} #{entry.EntityId}")</td>
                        <td>
                            <strong>@entry.Summary</strong>
                            @if (!string.IsNullOrWhiteSpace(entry.Details))
                            {
                                <div class="table-subline">@entry.Details</div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

        </div>
    </div>
