@model string
@switch (Model)
{
    case "details":
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" />
            <circle cx="12" cy="12" r="3.5" />
        </svg>
        break;
    case "visualize":
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 19V10" />
            <path d="M12 19V6" />
            <path d="M19 19V13" />
            <path d="M3 19h18" />
        </svg>
        break;
    case "edit":
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 20l4.5-1 9-9-3.5-3.5-9 9L4 20Z" />
            <path d="M13.5 6.5l3.5 3.5" />
            <path d="M4 20h16" />
        </svg>
        break;
    case "reset-password":
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="8" cy="12" r="3" />
            <path d="M11 12h9" />
            <path d="M17 12v3" />
            <path d="M20 12v2" />
        </svg>
        break;
    case "dependencies":
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="6" cy="12" r="2.5" />
            <circle cx="18" cy="6" r="2.5" />
            <circle cx="18" cy="18" r="2.5" />
            <path d="M8.25 11 15.5 7.1" />
            <path d="M8.25 13 15.5 16.9" />
        </svg>
        break;
    case "connect":
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 12h6" />
            <path d="M12 9v6" />
            <circle cx="6" cy="12" r="2.5" />
            <circle cx="18" cy="12" r="2.5" />
        </svg>
        break;
    case "history":
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 12a9 9 0 1 0 2.6-6.4" />
            <path d="M3 4v5h5" />
            <path d="M12 8v4l3 2" />
        </svg>
        break;
    case "trash":
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 7h16" />
            <path d="M9 4h6" />
            <path d="M7 7l1 12h8l1-12" />
            <path d="M10 11v5" />
            <path d="M14 11v5" />
        </svg>
        break;
    default:
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="7" />
        </svg>
        break;
}
