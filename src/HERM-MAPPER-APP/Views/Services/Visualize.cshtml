@using System.Text.Json
@using HERMMapperApp
@using HERMMapperApp.Models
@using HERMMapperApp.Services
@using HERMMapperApp.ViewModels
@model ServiceVisualizationViewModel
@{
    ViewData["Title"] = "Visualize Service Connections";
    ViewData["BodyClass"] = "services-page services-visualize-page";
    var canManageProductsAndServices = AppRoles.CanManageProductsAndServices(User);
    var productCount = Model.ProductNames.Count;
    if (productCount == 0)
    {
        productCount = Model.Connections
            .SelectMany(connection => new[] { connection.FromProductName, connection.ToProductName })
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
    }

    var hierarchyData = JsonSerializer.Serialize(
        Model.HierarchyRoot,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

<section class="page-header">
    <div>
        <span class="eyebrow">Connection view</span>
        <h1>@Model.Service.Name</h1>
        <p>Review the product flow for this service.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back to services</a>
        @if (canManageProductsAndServices)
        {
        <a class="btn btn-primary" asp-action="Connections" asp-route-id="@Model.Service.Id">Connect products</a>
        }
    </div>
</section>

<section class="stats-grid stats-grid-compact details-overview-grid">
    <article class="stat-card details-overview-card">
        <span class="stat-label">Connected products</span>
        <span class="stat-value">@productCount</span>
        <span class="stat-meta">products visible in this flow</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Connections</span>
        <span class="stat-value">@Model.Connections.Count</span>
        <span class="stat-meta">saved product-to-product links</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Layout mode</span>
        <span class="stat-value details-overview-value-small">Radial tree</span>
        <span class="stat-meta">@(Model.UsesGraphConnections ? "rendered from saved graph connections" : "rendered from saved linear flow")</span>
    </article>
    <article class="stat-card details-overview-card">
        <span class="stat-label">Lifecycle</span>
        <span class="stat-value details-overview-value-small">@Model.Service.LifecycleStatus</span>
        <span class="stat-meta">owner: @Model.Service.Owner</span>
    </article>
</section>

<section class="content-card details-primary-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Service sequence</span>
            <h2>Visualization</h2>
        </div>
    </div>

    @if (!Model.HasVisualization)
    {
        <div class="empty-state compact">
            <h3>No complete flow yet</h3>
            <p>Add at least one connected product pair to visualize the service flow.</p>
        </div>
    }
    else
    {
        @if (Model.UsesGraphConnections && !Model.SupportsGraphLayout)
        {
            <div class="alert alert-info">
                This service contains a loop. The radial tree repeats the returning product as a leaf to keep the path readable.
            </div>
        }

        <div class="application-radial-tree-shell" data-application-radial-tree-shell>
            <div class="application-radial-tree-toolbar">
                <button type="button"
                        class="application-radial-tree-fullscreen-button"
                        data-application-radial-tree-fullscreen
                        aria-label="Enter full screen"
                        title="Enter full screen">
                    <span class="application-radial-tree-fullscreen-icon" aria-hidden="true"></span>
                    <span data-application-radial-tree-fullscreen-label>Full screen</span>
                </button>
            </div>
            <script type="application/json" data-application-radial-tree-data>@Html.Raw(hierarchyData)</script>
            <div class="application-radial-tree"
                 data-application-radial-tree
                 data-include-products="true"
                 data-empty-title="No connected products yet"
                 data-empty-body="Add at least one connection to preview the service flow."></div>
            <p class="application-radial-tree-note">Drag to pan and use the mouse wheel to zoom. The radial tree starts from the service and expands through the connected product flow.</p>
        </div>

        <div class="table-responsive mt-4">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>From</th>
                        <th>To</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var connection in Model.Connections)
                {
                    <tr>
                        <td>@connection.Sequence</td>
                        <td>@connection.FromProductName</td>
                        <td>@connection.ToProductName</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/application-radial-tree.js" asp-append-version="true"></script>
}
