@using HERMMapperApp
@using HERMMapperApp.Models
@using HERMMapperApp.Services
@using HERMMapperApp.ViewModels
@model ServicesIndexViewModel
@{
    ViewData["Title"] = "Services";
    ViewData["BodyClass"] = "services-page";
    var canManageProductsAndServices = AppRoles.CanManageProductsAndServices(User);
    var statusMessage = TempData["ServicesStatusMessage"] as string;
    var errorMessage = TempData["ServicesErrorMessage"] as string;
    var ownerOptions = Model.AvailableOwners
        .Select(option => new
        {
            option.Value,
            IsSelected = string.Equals(Model.Owner, option.Value, StringComparison.OrdinalIgnoreCase)
        })
        .ToList();
    var lifecycleOptions = Model.LifecycleStatuses
        .Select(option => new
        {
            option.Value,
            IsSelected = string.Equals(Model.LifecycleStatus, option.Value, StringComparison.OrdinalIgnoreCase)
        })
        .ToList();
    var visibleOwnerCount = Model.Services
        .Select(service => service.Owner)
        .Where(owner => !string.IsNullOrWhiteSpace(owner))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    var totalConnections = Model.Services.Sum(service => service.ConnectionCount);
    var highCriticalityCount = Model.Services.Count(service => service.AssetCriticalityScore >= 4);
    var lifecycleSummary = string.IsNullOrWhiteSpace(Model.LifecycleStatus) ? "All states" : Model.LifecycleStatus;
}

<section class="page-header">
    <div>
        <span class="eyebrow">Service catalogue</span>
        <h1>Services</h1>
        <p>Define service details, then open the Connect products page for any service to build branching and merged flows.</p>
    </div>
    @if (canManageProductsAndServices)
    {
        <a class="btn btn-primary" asp-action="Create">Add service</a>
    }
</section>

<section class="stats-grid stats-grid-compact services-overview-grid">
    <article class="stat-card services-overview-card">
        <span class="stat-label">Visible services</span>
        <span class="stat-value">@Model.Services.Count</span>
        <span class="stat-meta">matching the active filters</span>
    </article>
    <article class="stat-card services-overview-card">
        <span class="stat-label">Owners in view</span>
        <span class="stat-value">@visibleOwnerCount</span>
        <span class="stat-meta">distinct owners across results</span>
    </article>
    <article class="stat-card services-overview-card">
        <span class="stat-label">Connected flows</span>
        <span class="stat-value">@totalConnections</span>
        <span class="stat-meta">incoming and outgoing product links</span>
    </article>
    <article class="stat-card services-overview-card">
        <span class="stat-label">High ACS services</span>
        <span class="stat-value">@highCriticalityCount</span>
        <span class="stat-meta">@lifecycleSummary</span>
    </article>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<section class="content-card services-filter-card">
    <form method="get" class="row g-3 align-items-end service-filter-form">
        <div class="col-lg-4">
            <label class="form-label" for="search">Search services</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Service, owner, status, or connected product" />
        </div>
        <div class="col-lg-2">
            <label class="form-label" for="owner">Owner</label>
            <select class="form-select" id="owner" name="owner">
                <option value="">All owners</option>
                @foreach (var ownerOption in ownerOptions)
                {
                    <option value="@ownerOption.Value" selected="@(ownerOption.IsSelected ? "selected" : null)">@ownerOption.Value</option>
                }
            </select>
        </div>
        <div class="col-lg-2">
            <label class="form-label" for="lifecycleStatus">Lifecycle</label>
            <select class="form-select" id="lifecycleStatus" name="lifecycleStatus">
                <option value="">All lifecycle states</option>
                @foreach (var lifecycleOption in lifecycleOptions)
                {
                    <option value="@lifecycleOption.Value" selected="@(lifecycleOption.IsSelected ? "selected" : null)">@lifecycleOption.Value</option>
                }
            </select>
        </div>
        <div class="col-lg-4">
            <label class="form-label" for="sort">Sort</label>
            <select class="form-select" id="sort" name="sort">
                <option value="@ServiceSortOptions.UpdatedDesc" selected="@(Model.Sort == ServiceSortOptions.UpdatedDesc ? "selected" : null)">Last updated, newest first</option>
                <option value="@ServiceSortOptions.UpdatedAsc" selected="@(Model.Sort == ServiceSortOptions.UpdatedAsc ? "selected" : null)">Last updated, oldest first</option>
                <option value="@ServiceSortOptions.Name" selected="@(Model.Sort == ServiceSortOptions.Name ? "selected" : null)">Name, A-Z</option>
                <option value="@ServiceSortOptions.NameDesc" selected="@(Model.Sort == ServiceSortOptions.NameDesc ? "selected" : null)">Name, Z-A</option>
                <option value="@ServiceSortOptions.Owner" selected="@(Model.Sort == ServiceSortOptions.Owner ? "selected" : null)">Owner, A-Z</option>
                <option value="@ServiceSortOptions.Lifecycle" selected="@(Model.Sort == ServiceSortOptions.Lifecycle ? "selected" : null)">Lifecycle, A-Z</option>
                <option value="@ServiceSortOptions.ProductCountDesc" selected="@(Model.Sort == ServiceSortOptions.ProductCountDesc ? "selected" : null)">Most connected products first</option>
            </select>
        </div>
        <div class="col-12 d-flex gap-2 justify-content-end">
            <button class="btn btn-primary" type="submit">Apply</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </form>
</section>

<section class="content-card services-results-card">
    @if (canManageProductsAndServices && Model.Services.Count != 0)
    {
        <div class="alert alert-info" role="status">
            Open <strong>Connect products</strong> from a service row, or click the service name, to use the new connection designer page.
        </div>
    }

    <div class="section-heading">
        <div>
            <span class="eyebrow">Services</span>
            <h2>@Model.Services.Count result(s)</h2>
            <p>Review service ownership, lifecycle, and connected-product complexity without leaving the catalogue index.</p>
        </div>
    </div>

    @if (Model.Services.Count == 0)
    {
        <div class="empty-state compact">
            <h3>No matching services</h3>
            <p>Try a wider search, clear the filters, or create the first service. After saving a service, you’ll be taken straight to Connect products.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th>ACS</th>
                        <th>Connected products</th>
                        <th>Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var service in Model.Services)
                {
                    <tr>
                        <td>
                            @if (canManageProductsAndServices)
                            {
                                <strong><a asp-action="Connections" asp-route-id="@service.Id">@service.Name</a></strong>
                            }
                            else
                            {
                                <strong>@service.Name</strong>
                            }
                            <div class="table-subline">@(string.IsNullOrWhiteSpace(service.Description) ? "No description provided." : service.Description)</div>
                        </td>
                        <td>@service.Owner</td>
                        <td>@service.LifecycleStatus</td>
                        <td>@service.AssetCriticalityScore</td>
                        <td>
                            <strong>@service.ConnectionCount connection(s)</strong>
                            <div class="table-subline">@service.ProductPreview</div>
                        </td>
                        <td>@await TimeZoneDisplay.FormatUtcAsync(service.UpdatedUtc)</td>
                        <td class="text-end">
                            <div class="table-action-group">
                                <a class="table-action-button"
                                   asp-action="Visualize"
                                   asp-route-id="@service.Id"
                                   title="Visualize @service.Name"
                                   aria-label="Visualize @service.Name">
                                    <partial name="_ActionIcon" model="@("visualize")" />
                                    <span class="visually-hidden">Visualize</span>
                                </a>
                                @if (canManageProductsAndServices)
                                {
                                    <a class="table-action-button"
                                       asp-action="Connections"
                                       asp-route-id="@service.Id"
                                       title="Connect products for @service.Name"
                                       aria-label="Connect products for @service.Name">
                                        <partial name="_ActionIcon" model="@("connect")" />
                                        <span class="visually-hidden">Connect products</span>
                                    </a>
                                    <a class="table-action-button"
                                       asp-action="Edit"
                                       asp-route-id="@service.Id"
                                       title="Edit details for @service.Name"
                                       aria-label="Edit details for @service.Name">
                                        <partial name="_ActionIcon" model="@("edit")" />
                                        <span class="visually-hidden">Edit details</span>
                                    </a>
                                    <a class="table-action-button table-action-button-danger"
                                       asp-action="Delete"
                                       asp-route-id="@service.Id"
                                       title="Move @service.Name to trash"
                                       aria-label="Move @service.Name to trash">
                                        <partial name="_ActionIcon" model="@("trash")" />
                                        <span class="visually-hidden">Trash</span>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
