@model ModelDiagramReportViewModel

<div class="model-report-canvas">
    @{
        var visibleDomains = Model.OnlyShowMappedNodes
            ? Model.Domains.Where(x => x.ProductCount > 0).ToList()
            : Model.Domains;
    }

    @foreach (var domain in visibleDomains)
    {
        var visibleCapabilities = Model.OnlyShowMappedNodes
            ? domain.Capabilities.Where(x => x.ProductCount > 0).ToList()
            : domain.Capabilities;
        var domainSummaryParts = new List<string>
        {
            $"{domain.CapabilityCount} capability(s)",
            $"{domain.ComponentCount} component(s)"
        };

        if (domain.ProductCount > 0)
        {
            domainSummaryParts.Add(Model.FormatMappedSummary(domain.ProductCount));
        }

        <article class="model-report-domain">
            <header class="model-report-domain-header">
                <span class="model-report-domain-code">@domain.Code</span>
                <h3>@domain.Name</h3>
                <span class="table-subline">@string.Join(", ", domainSummaryParts)</span>
            </header>

            @if (visibleCapabilities.Count == 0)
            {
                @if (Model.ShowBranchEmptyStates)
                {
                    <div class="model-report-empty-card">No capabilities are available in this domain yet.</div>
                }
            }
            else
            {
                <div class="model-report-capability-grid">
                    @foreach (var capability in visibleCapabilities)
                    {
                        var visibleComponents = Model.OnlyShowMappedNodes
                            ? capability.Components.Where(x => x.ProductCount > 0).ToList()
                            : capability.Components;
                        var capabilitySummaryParts = new List<string>
                        {
                            $"{capability.ComponentCount} component(s)"
                        };

                        if (capability.ProductCount > 0)
                        {
                            capabilitySummaryParts.Add(Model.FormatMappedSummary(capability.ProductCount));
                        }

                        <section class="model-report-capability">
                            <header class="model-report-capability-header">
                                <strong>@capability.DisplayLabel</strong>
                                <span class="table-subline">@string.Join(", ", capabilitySummaryParts)</span>
                            </header>

                            @if (visibleComponents.Count == 0)
                            {
                                @if (Model.ShowBranchEmptyStates)
                                {
                                    <div class="model-report-empty-card">No components are linked to this capability yet.</div>
                                }
                            }
                            else
                            {
                                <div class="model-report-component-list">
                                    @foreach (var component in visibleComponents)
                                    {
                                        <article class="model-report-component">
                                            <div class="model-report-component-header">
                                                <strong>@component.DisplayLabel</strong>
                                                @if (Model.ShowComponentMappedSummary && component.ProductCount > 0)
                                                {
                                                    <span class="table-subline">@Model.FormatMappedSummary(component.ProductCount)</span>
                                                }
                                            </div>

                                            @if (component.Products.Count > 0)
                                            {
                                                <ul class="model-report-product-list">
                                                    @foreach (var product in component.Products)
                                                    {
                                                        <li class="model-report-product">
                                                            @if (product.HasLink)
                                                            {
                                                                <a class="model-report-product-link" asp-controller="@product.LinkController" asp-action="@product.LinkAction" asp-route-id="@product.LinkId">@product.Name</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="model-report-product-link">@product.Name</span>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            }
        </article>
    }

    @if (Model.ShowUnmappedItems && Model.UnmappedProducts.Count > 0)
    {
        <article class="model-report-domain model-report-domain-unmapped">
            <header class="model-report-domain-header">
                <span class="model-report-domain-code">UNMAPPED</span>
                <h3>@Model.UnmappedSectionTitle</h3>
                <span class="table-subline">@Model.UnmappedProducts.Count @Model.UnmappedSummaryLabel</span>
            </header>

            <div class="model-report-unmapped-list">
                @foreach (var product in Model.UnmappedProducts)
                {
                    <article class="model-report-unmapped-card">
                        @if (product.HasLink)
                        {
                            <a class="model-report-product-link" asp-controller="@product.LinkController" asp-action="@product.LinkAction" asp-route-id="@product.LinkId">@product.Name</a>
                        }
                        else
                        {
                            <span class="model-report-product-link">@product.Name</span>
                        }
                    </article>
                }
            </div>
        </article>
    }
</div>
