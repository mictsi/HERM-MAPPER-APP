@model ModelDiagramReportViewModel
@{
    ViewData["Title"] = Model.PosterTitle;
    ViewData["BodyClass"] = "report-poster-mode";
    var usesSvgPoster = !string.IsNullOrWhiteSpace(Model.PosterSvgMarkup);
    var posterPageClass = usesSvgPoster
        ? "model-report-poster-page"
        : "model-report-poster-page model-report-poster-page-html-fallback";
    var posterFrameClass = usesSvgPoster
        ? "model-report-poster-frame"
        : "model-report-poster-frame model-report-poster-frame-html-fallback";
    var posterStageClass = usesSvgPoster
        ? "model-report-poster-stage"
        : "model-report-poster-stage model-report-poster-stage-html-fallback";
}

<section class="@posterPageClass">
    <div class="model-report-poster-toolbar">
        <div>
            <span class="eyebrow">Reports</span>
            <h1>@Model.PosterTitle</h1>
            <p>@Model.PosterDescription</p>
        </div>
        <div class="report-toolbar-actions">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-brmModelId="@Model.BrmModelId" asp-fragment="@Model.ReportFragmentId">Back to reports</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="DownloadModelDiagramSvg" asp-route-scope="@Model.ScopeKey" asp-route-brmModelId="@Model.BrmModelId">Download SVG</a>
            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="window.print()">Print / Save PDF</button>
            @if (!string.IsNullOrWhiteSpace(Model.DrawIoDownloadAction))
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="@Model.DrawIoDownloadAction" asp-route-scope="@Model.ScopeKey" asp-route-brmModelId="@Model.BrmModelId">Download draw.io</a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ArchiDownloadAction))
            {
                <a class="btn btn-primary btn-sm" asp-action="@Model.ArchiDownloadAction" asp-route-scope="@Model.ScopeKey" asp-route-brmModelId="@Model.BrmModelId">Download Archi XML</a>
            }
        </div>
    </div>

    @if (!Model.HasAnyContent)
    {
        <div class="empty-state compact">
            <h3>@Model.EmptyStateTitle</h3>
            <p>@Model.EmptyStateBody</p>
        </div>
    }
    else
    {
        <div class="@posterFrameClass">
            <div class="@posterStageClass">
                @if (usesSvgPoster)
                {
                    <div class="model-report-poster-svg-shell">
                        @Html.Raw(Model.PosterSvgMarkup)
                    </div>
                }
                else
                {
                    <partial name="_ModelDiagramReport" model="Model" />
                }
            </div>
        </div>
    }
</section>
