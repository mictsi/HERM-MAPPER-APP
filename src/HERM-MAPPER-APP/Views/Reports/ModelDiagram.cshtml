@model ModelDiagramReportViewModel
@{
    ViewData["Title"] = Model.PosterTitle;
    ViewData["BodyClass"] = "report-poster-mode";
}

<section class="model-report-poster-page">
    <div class="model-report-poster-toolbar">
        <div>
            <span class="eyebrow">Reports</span>
            <h1>@Model.PosterTitle</h1>
            <p>@Model.PosterDescription</p>
        </div>
        <div class="report-toolbar-actions">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-fragment="@Model.ReportFragmentId">Back to reports</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="DownloadModelDiagramSvg" asp-route-scope="@Model.ScopeKey">Download SVG</a>
            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="window.print()">Print / Save PDF</button>
            @if (!string.IsNullOrWhiteSpace(Model.DrawIoDownloadAction))
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="@Model.DrawIoDownloadAction" asp-route-scope="@Model.ScopeKey">Download draw.io</a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ArchiDownloadAction))
            {
                <a class="btn btn-primary btn-sm" asp-action="@Model.ArchiDownloadAction" asp-route-scope="@Model.ScopeKey">Download Archi XML</a>
            }
        </div>
    </div>

    @if (!Model.HasAnyContent)
    {
        <div class="empty-state compact">
            <h3>@Model.EmptyStateTitle</h3>
            <p>@Model.EmptyStateBody</p>
        </div>
    }
    else
    {
        <div class="model-report-poster-frame">
            <div class="model-report-poster-stage">
                @if (!string.IsNullOrWhiteSpace(Model.PosterSvgMarkup))
                {
                    <div class="model-report-poster-svg-shell">
                        @Html.Raw(Model.PosterSvgMarkup)
                    </div>
                }
                else
                {
                    <partial name="_ModelDiagramReport" model="Model" />
                }
            </div>
        </div>
    }
</section>
