@model ModelDiagramReportViewModel
@{
    ViewData["Title"] = "Product model poster";
    ViewData["BodyClass"] = "report-poster-mode";
}

<section class="model-report-poster-page">
    <div class="model-report-poster-toolbar">
        <div>
            <span class="eyebrow">Reports</span>
            <h1>Product model poster</h1>
            <p>Full-screen poster view of the HERM model with products placed directly inside each component column.</p>
        </div>
        <div class="report-toolbar-actions">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-fragment="report-product-model">Back to reports</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="DownloadDrawIo">Download draw.io</a>
            <a class="btn btn-primary btn-sm" asp-action="DownloadArchiXml">Download Archi XML</a>
        </div>
    </div>

    @if (!Model.HasAnyContent)
    {
        <div class="empty-state compact">
            <h3>No model content available</h3>
            <p>Import the HERM reference model and product mappings to populate this report.</p>
        </div>
    }
    else
    {
        <div class="report-summary-chips">
            <span class="report-summary-chip"><strong>@Model.DomainCount</strong> domains</span>
            <span class="report-summary-chip"><strong>@Model.CapabilityCount</strong> capabilities</span>
            <span class="report-summary-chip"><strong>@Model.ComponentCount</strong> components</span>
            <span class="report-summary-chip"><strong>@Model.ProductCount</strong> products</span>
            <span class="report-summary-chip"><strong>@Model.UnmappedProductCount</strong> unmapped</span>
        </div>

        <div class="model-report-poster-frame">
            <partial name="_ModelDiagramReport" model="Model" />
        </div>
    }
</section>
