@model ConfigurationIndexViewModel
@using HERMMapperApp.Services
@using HERMMapperApp.ViewModels
@{
    ViewData["Title"] = "Configuration";
    ViewData["AdminNav"] = "Configuration";
    ViewData["BodyClass"] = "admin-page configuration-page";
    bool showErrorForSection(string sectionKey) =>
        !string.IsNullOrWhiteSpace(Model.ErrorMessage) &&
        string.Equals(Model.ErrorSectionKey, sectionKey, StringComparison.OrdinalIgnoreCase);
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <section class="page-header">
            <div>
                <span class="eyebrow">App settings</span>
                <h1>Configuration</h1>
                <p>Manage display settings and the allowed values for configurable product and mapping fields.</p>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <section class="content-card">
                <div class="alert alert-success mb-0">@Model.StatusMessage</div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage) && string.IsNullOrWhiteSpace(Model.ErrorSectionKey))
        {
            <section class="content-card">
                <div class="alert alert-danger mb-0">@Model.ErrorMessage</div>
            </section>
        }

        <section class="content-card">
            @if (showErrorForSection("display-time-zone"))
            {
                <div class="alert alert-danger mb-3">@Model.ErrorMessage</div>
            }
            <details class="admin-disclosure">
                <summary class="admin-disclosure-summary">
                    <div>
                        <span class="eyebrow">Regional display</span>
                        <h2>Change time zone</h2>
                        <p>Choose the time zone used when timestamps are shown in the application.</p>
                    </div>
                    <span class="admin-disclosure-meta">@Model.DisplayTimeZoneId</span>
                </summary>
                <div class="admin-disclosure-body">
                    <p class="mb-3">All timestamps are stored in UTC. Choose the time zone used when dates are shown in the application.</p>
                    <form asp-action="UpdateDisplayTimeZone" method="post" class="row g-3 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-lg-8">
                            <label class="form-label" for="TimeZoneId">Time zone</label>
                            <select class="form-select" id="TimeZoneId" name="TimeZoneId" asp-items="Model.AvailableTimeZones"></select>
                        </div>
                        <div class="col-lg-4 d-grid">
                            <button class="btn btn-primary" type="submit">Save time zone</button>
                        </div>
                    </form>
                </div>
            </details>
        </section>

        @foreach (var field in Model.Fields)
        {
            var isExpandedField = string.Equals(Model.ExpandedFieldName, field.FieldName, StringComparison.OrdinalIgnoreCase);
            var fieldSectionKey = $"field:{field.FieldName}";
            <section class="content-card">
                @if (showErrorForSection(fieldSectionKey))
                {
                    <div class="alert alert-danger mb-3">@Model.ErrorMessage</div>
                }
                <details class="admin-disclosure" @(isExpandedField ? "open" : null)>
                    <summary class="admin-disclosure-summary">
                        <div>
                            <span class="eyebrow">Configurable field</span>
                            <h2>@field.Label</h2>
                            <p>Manage the allowed values and order for this field.</p>
                        </div>
                        <span class="admin-disclosure-meta">@field.Options.Count value@(field.Options.Count == 1 ? string.Empty : "s")</span>
                    </summary>
                    <div class="admin-disclosure-body">
                        <div class="row g-4">
                            <div class="col-lg-7">
                                @if (field.Options.Count == 0)
                                {
                                    <div class="empty-state compact">
                                        <h3>No values configured</h3>
                                        <p>Add the first allowed value for this field.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="config-option-editor" data-config-option-editor>
                                        <div class="config-option-list" data-config-option-list>
                                        @foreach (var option in field.Options)
                                        {
                                            <article class="config-option-row" data-config-option-row data-config-option-id="@option.Id" draggable="true">
                                                <div class="config-option-handle" data-config-option-handle title="Drag to reorder" aria-hidden="true">&#8645;</div>
                                                <div class="config-option-order" data-config-option-order>@option.SortOrder</div>
                                                <div class="config-option-main">
                                                    <div class="config-option-edit-row">
                                                        <form asp-action="UpdateOption" method="post" class="config-option-edit-form" id="config-option-edit-@option.Id">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="Id" value="@option.Id" />
                                                            <label class="visually-hidden" for="config-option-@option.Id">@field.Label value</label>
                                                            <input class="form-control form-control-sm" id="config-option-@option.Id" type="text" name="Value" value="@option.Value" maxlength="120" />
                                                        </form>
                                                        <div class="config-option-actions">
                                                            <button type="submit" class="btn btn-sm btn-outline-secondary" form="config-option-edit-@option.Id">Save</button>
                                                            <form asp-action="DeleteOption" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@option.Id" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                    <div class="config-option-meta">Created @await TimeZoneDisplay.FormatUtcAsync(option.CreatedUtc)</div>
                                                </div>
                                            </article>
                                        }
                                        </div>

                                        <form asp-action="ReorderOptions" method="post" class="config-option-order-form mt-3" data-config-option-order-form>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="FieldName" value="@field.FieldName" />
                                            <div data-config-option-order-inputs></div>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" data-config-option-order-save disabled>Save sort order</button>
                                            <span class="form-text mb-0">Drag rows to reorder the allowed values, then save the new order.</span>
                                        </form>
                                    </div>
                                }
                            </div>
                            <div class="col-lg-5">
                                <section class="content-card h-100">
                                    <div class="section-heading">
                                        <div>
                                            <span class="eyebrow">Add value</span>
                                            <h3 class="mb-0">New @field.Label option</h3>
                                        </div>
                                    </div>

                                    <form asp-action="AddOption" method="post" class="d-grid gap-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="FieldName" value="@field.FieldName" />
                                        <div>
                                            <label class="form-label" for="value-@field.FieldName">Value</label>
                                            <input class="form-control" id="value-@field.FieldName" name="Value" placeholder="Enter a value" />
                                        </div>
                                        <button type="submit" class="btn btn-primary">Add value</button>
                                    </form>
                                </section>
                            </div>
                        </div>
                    </div>
                </details>
            </section>
        }
    </div>
</div>
