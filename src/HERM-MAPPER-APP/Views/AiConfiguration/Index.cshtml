@using HERMMapperApp.Services
@using HERMMapperApp.ViewModels
@model AiMappingAdminIndexViewModel
@{
    ViewData["Title"] = "AI Configuration";
    ViewData["AdminNav"] = "AiConfiguration";
    ViewData["BodyClass"] = "admin-page ai-configuration-page";
    var editor = Model.Editor;
    var isEditing = Model.ShowEditor && !Model.IsCreatingProvider && editor.Id.HasValue;
    var editorHasStoredApiKey = Model.EditorHasStoredApiKey;
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="admin-content">
        <section class="page-header">
            <div>
                <span class="eyebrow">Admin</span>
                <h1>AI configuration</h1>
                <p>Manage multiple AI provider configurations, enable one service at a time, and review token usage for AI-assisted mapping requests.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-outline-secondary" asp-controller="Configuration" asp-action="Index">Back to configuration</a>
                <a class="btn btn-outline-primary" asp-action="Index" asp-route-createNewProvider="true">New provider</a>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <section class="content-card">
                <div class="alert alert-success mb-0">@Model.StatusMessage</div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <section class="content-card">
                <div class="alert alert-danger mb-0">@Model.ErrorMessage</div>
            </section>
        }

        <section class="stats-grid stats-grid-compact import-stats ai-kpi-grid">
            <article class="stat-card @(Model.CanLookup ? "import-status-card-success" : "import-status-card-warning")">
                <span class="stat-label">Lookup status</span>
                <span class="stat-value">@(Model.LookupEnabled ? "Enabled" : "Disabled")</span>
                <span class="stat-meta">@(Model.CanLookup ? "Users can start AI lookups." : "Enable the global toggle and one provider.")</span>
            </article>
            <article class="stat-card import-status-card-success">
                <span class="stat-label">Enabled provider</span>
                <span class="stat-value">@Model.Dashboard.ActiveProviderName</span>
                <span class="stat-meta">@Model.Dashboard.ActiveProviderLabel</span>
            </article>
            <article class="stat-card import-status-card-success">
                <span class="stat-label">Providers</span>
                <span class="stat-value">@Model.Dashboard.ConfiguredProviderCount / @Model.Dashboard.ProviderCount</span>
                <span class="stat-meta">ready / total</span>
            </article>
            <article class="stat-card import-status-card-success">
                <span class="stat-label">Requests today</span>
                <span class="stat-value">@Model.Dashboard.RequestsToday</span>
                <span class="stat-meta">all outcomes since midnight UTC</span>
            </article>
            <article class="stat-card import-status-card-success">
                <span class="stat-label">Requests last 7 days</span>
                <span class="stat-value">@Model.Dashboard.RequestsLast7Days</span>
                <span class="stat-meta">all lookups in the last week</span>
            </article>
            <article class="stat-card import-status-card-success">
                <span class="stat-label">Tokens today</span>
                <span class="stat-value">@Model.Dashboard.TokensToday</span>
                <span class="stat-meta">prompt + completion tokens</span>
            </article>
            <article class="stat-card import-status-card-success">
                <span class="stat-label">Tokens last 7 days</span>
                <span class="stat-value">@Model.Dashboard.TokensLast7Days</span>
                <span class="stat-meta">tracked token usage</span>
            </article>
            <article class="stat-card import-status-card-success">
                <span class="stat-label">7-day average</span>
                <span class="stat-value">@Model.Dashboard.AverageTokensPerRequestLast7Days</span>
                <span class="stat-meta">tokens per successful request</span>
            </article>
            <article class="stat-card import-status-card-warning">
                <span class="stat-label">Timed out</span>
                <span class="stat-value">@Model.Dashboard.TimedOutRequestsLast7Days</span>
                <span class="stat-meta">@Model.Dashboard.TimedOutRequestsToday today / @Model.Dashboard.TimedOutRequestsLast7Days 7d</span>
            </article>
            <article class="stat-card import-status-card-warning">
                <span class="stat-label">Cancelled</span>
                <span class="stat-value">@Model.Dashboard.CancelledRequestsLast7Days</span>
                <span class="stat-meta">@Model.Dashboard.CancelledRequestsToday today / @Model.Dashboard.CancelledRequestsLast7Days 7d</span>
            </article>
            <article class="stat-card import-status-card-warning">
                <span class="stat-label">Aborted</span>
                <span class="stat-value">@Model.Dashboard.AbortedRequestsLast7Days</span>
                <span class="stat-meta">@Model.Dashboard.AbortedRequestsToday today / @Model.Dashboard.AbortedRequestsLast7Days 7d</span>
            </article>
            <article class="stat-card import-status-card-success">
                <span class="stat-label">Last request</span>
                <span class="stat-value">@(Model.Dashboard.LastRequestUtc.HasValue ? "Recorded" : "None yet")</span>
                <span class="stat-meta">
                    @(Model.Dashboard.LastRequestUtc.HasValue
                        ? await TimeZoneDisplay.FormatUtcAsync(Model.Dashboard.LastRequestUtc.Value)
                        : "Appears after the first AI lookup.")
                </span>
            </article>
        </section>

        <section class="content-card">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Runtime control</span>
                    <h2>AI lookup toggle</h2>
                </div>
            </div>
            <p class="mb-3">When this toggle is off, the <strong>Add mappings with AI</strong> button remains visible on product details pages but cannot be clicked.</p>
            <form asp-action="SetLookupEnabled" method="post" class="ai-runtime-toggle-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="isEnabled" value="@(Model.LookupEnabled ? "false" : "true")" />
                <button class="ai-runtime-toggle-button @(Model.LookupEnabled ? "ai-runtime-toggle-button-on" : "ai-runtime-toggle-button-off")" type="submit" role="switch" aria-checked="@(Model.LookupEnabled ? "true" : "false")" aria-label="@(Model.LookupEnabled ? "Disable AI lookup" : "Enable AI lookup")">
                    <span class="ai-runtime-toggle-copy">
                        <span class="ai-runtime-toggle-label">AI lookup</span>
                        <span class="ai-runtime-toggle-value">@(Model.LookupEnabled ? "Enabled" : "Disabled")</span>
                        <span class="ai-runtime-toggle-meta">@(Model.LookupEnabled ? "Click to disable product page lookups." : "Click to enable product page lookups.")</span>
                    </span>
                    <span class="ai-runtime-toggle-visual" aria-hidden="true">
                        <span class="ai-runtime-toggle-track">
                            <span class="ai-runtime-toggle-thumb"></span>
                        </span>
                    </span>
                </button>
            </form>
        </section>

        <section class="content-card">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Provider catalogue</span>
                    <h2>Saved AI providers</h2>
                </div>
            </div>

            @if (Model.Providers.Count == 0)
            {
                <div class="empty-state compact">
                    <h3>No AI providers yet</h3>
                    <p>Use <strong>New provider</strong> to create the first provider configuration and enable AI-assisted mapping.</p>
                </div>
            }
            else
            {
                <div class="ai-provider-grid">
                    @foreach (var provider in Model.Providers)
                    {
                        <article class="content-card h-100 ai-provider-card @(provider.IsActive ? "ai-provider-card-active" : null)">
                            <div class="ai-provider-card-header">
                                <div class="ai-provider-card-title">
                                    <span class="eyebrow">@provider.ProviderLabel</span>
                                    <h3 class="mb-1">@provider.Name</h3>
                                    <p class="mb-0 text-muted small ai-provider-endpoint">@provider.Endpoint</p>
                                </div>
                                <div class="ai-provider-card-actions">
                                    <form asp-action="SetProviderEnabled" method="post" class="ai-provider-status-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@provider.Id" />
                                        <input type="hidden" name="isEnabled" value="@(provider.IsActive ? "true" : "false")" />
                                        <div class="form-check form-switch m-0">
                                            @if (provider.IsActive)
                                            {
                                                <input class="form-check-input" type="checkbox" role="switch" checked="checked" aria-label="Disable @provider.Name" onchange="this.form.querySelector('input[name=&quot;isEnabled&quot;]').value = this.checked ? 'true' : 'false'; this.form.submit();" />
                                            }
                                            else
                                            {
                                                <input class="form-check-input" type="checkbox" role="switch" aria-label="Enable @provider.Name" onchange="this.form.querySelector('input[name=&quot;isEnabled&quot;]').value = this.checked ? 'true' : 'false'; this.form.submit();" />
                                            }
                                        </div>
                                        <span class="small fw-semibold ai-provider-status-text @(provider.IsActive ? "text-success" : "text-muted")">
                                            @(provider.IsActive ? "Enabled" : "Disabled")
                                        </span>
                                    </form>
                                    <a class="ai-provider-action" asp-action="Index" asp-route-editProviderId="@provider.Id" title="Edit provider" aria-label="Edit provider">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M4 20h4l10-10-4-4L4 16v4Z" />
                                            <path d="m13 7 4 4" />
                                            <path d="M15 5 19 9" />
                                        </svg>
                                        <span class="visually-hidden">Edit</span>
                                    </a>
                                    <form asp-action="DeleteProvider" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this AI provider? This cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@provider.Id" />
                                        <button class="ai-provider-action ai-provider-action-danger" type="submit" title="Permanently delete provider" aria-label="Permanently delete provider">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M4 7h16" />
                                                <path d="M10 11v6" />
                                                <path d="M14 11v6" />
                                                <path d="M6 7l1 12h10l1-12" />
                                                <path d="M9 7V4h6v3" />
                                            </svg>
                                            <span class="visually-hidden">Delete</span>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <div class="d-flex gap-2 flex-wrap mb-2 ai-provider-badges">
                                <span class="badge @(provider.IsConfigured ? "text-bg-success" : "text-bg-warning")">
                                    @(provider.IsConfigured ? "Ready" : "Needs model or key")
                                </span>
                                <span class="badge text-bg-light border">@provider.ProviderLabel</span>
                            </div>

                            <dl class="detail-grid mb-0 ai-provider-detail-grid">
                                <dt>Model</dt>
                                <dd>@(string.IsNullOrWhiteSpace(provider.Model) ? "Not selected yet" : provider.Model)</dd>
                                <dt>API key</dt>
                                <dd>@provider.SavedApiKeyDisplay</dd>
                                <dt>Timeout</dt>
                                <dd>@provider.TimeoutSeconds seconds</dd>
                                <dt>Last 7 days</dt>
                                <dd>@provider.RequestsLast7Days request(s), @provider.TokensLast7Days token(s)</dd>
                                @if (!string.IsNullOrWhiteSpace(provider.ApiVersion))
                                {
                                    <dt>API version</dt>
                                    <dd>@provider.ApiVersion</dd>
                                }
                            </dl>
                        </article>
                    }
                </div>
            }
        </section>

        @if (Model.ShowEditor)
        {
            <section class="content-card">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">Provider editor</span>
                        <h2>@(isEditing ? $"Edit {editor.Name}" : "Add AI provider")</h2>
                    </div>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                </div>

                <p class="mb-3">Use OpenAI-compatible chat completion endpoints. Open WebUI and OpenAI use bearer authentication. Azure AI Foundry uses the <code>api-key</code> header and can optionally append an <code>api-version</code> query string.</p>
                <p class="text-muted small mb-3">For Open WebUI, save the endpoint and API key first. This page then refreshes the model dropdown by calling <code>/api/models</code> with the stored bearer token.</p>

                <form asp-action="SaveProvider" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input asp-for="Editor.Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : null)"></div>

                    <div class="col-lg-4">
                        <label class="form-label" asp-for="Editor.Name"></label>
                        <input class="form-control" asp-for="Editor.Name" />
                        <span class="text-danger" asp-validation-for="Editor.Name"></span>
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label" asp-for="Editor.ProviderType"></label>
                        <select class="form-select" asp-for="Editor.ProviderType" asp-items="Model.ProviderTypeOptions"></select>
                        <span class="text-danger" asp-validation-for="Editor.ProviderType"></span>
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label" asp-for="Editor.TimeoutSeconds"></label>
                        <input class="form-control" asp-for="Editor.TimeoutSeconds" type="number" min="1" max="3600" />
                        <div class="form-text">Default: 120 seconds.</div>
                        <span class="text-danger" asp-validation-for="Editor.TimeoutSeconds"></span>
                    </div>
                    <div class="col-lg-8">
                        <label class="form-label" asp-for="Editor.Endpoint"></label>
                        <input class="form-control" asp-for="Editor.Endpoint" autocomplete="off" />
                        <div class="form-text">Examples: <code>http://localhost:3000/api/chat/completions</code>, <code>https://api.openai.com/v1/chat/completions</code>, or an Azure AI Foundry chat completion endpoint.</div>
                        <span class="text-danger" asp-validation-for="Editor.Endpoint"></span>
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label" asp-for="Editor.ApiVersion"></label>
                        <input class="form-control" asp-for="Editor.ApiVersion" autocomplete="off" />
                        <div class="form-text">Optional. Used for Azure AI Foundry endpoints that require <code>api-version</code>.</div>
                        <span class="text-danger" asp-validation-for="Editor.ApiVersion"></span>
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label" asp-for="Editor.Model"></label>
                        @if (Model.ModelOptions.Count != 0)
                        {
                            <select class="form-select" asp-for="Editor.Model" asp-items="Model.ModelOptions"></select>
                            <div class="form-text">Loaded from the provider model API when this editor opens.</div>
                        }
                        else
                        {
                            <input class="form-control" asp-for="Editor.Model" autocomplete="off" />
                            @if (editor.ProviderType == HERMMapperApp.Models.AiProviderType.OpenWebUi)
                            {
                                <div class="form-text">Save the provider first to load available Open WebUI models from <code>/api/models</code>.</div>
                            }
                        }
                        <span class="text-danger" asp-validation-for="Editor.Model"></span>
                    </div>
                    <div class="col-lg-6">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <label class="form-label mb-0" asp-for="Editor.ApiKey"></label>
                            @if (editorHasStoredApiKey)
                            {
                                <span class="small text-success">(Key is stored in database)</span>
                            }
                        </div>
                        <input class="form-control" asp-for="Editor.ApiKey" type="password" autocomplete="new-password" />
                        <div class="form-text">Leave this blank when editing to keep the stored key.</div>
                        <span class="text-danger" asp-validation-for="Editor.ApiKey"></span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ModelDiscoveryError) && Model.SupportsModelDiscovery)
                    {
                        <div class="col-12">
                            <div class="alert alert-warning mb-0">@Model.ModelDiscoveryError</div>
                        </div>
                    }

                    <div class="col-12 d-flex gap-2 flex-wrap">
                        <button class="btn btn-primary" type="submit">@(isEditing ? "Save provider" : "Create provider")</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </section>
        }

        <section class="content-card">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Usage history</span>
                    <h2>Recent token usage</h2>
                </div>
            </div>

            @if (Model.RecentUsage.Count == 0)
            {
                <div class="empty-state compact">
                    <h3>No AI requests yet</h3>
                    <p>Usage rows appear here after the first AI-assisted mapping request runs.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Provider</th>
                                <th>Request</th>
                                <th>Model</th>
                                <th>Prompt</th>
                                <th>Completion</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var entry in Model.RecentUsage)
                        {
                            <tr>
                                <td>@await TimeZoneDisplay.FormatUtcAsync(entry.OccurredUtc)</td>
                                <td>
                                    <strong>@entry.ProviderName</strong>
                                    <div class="text-muted small">@entry.ProviderLabel</div>
                                </td>
                                <td>
                                    <strong>@entry.RequestSummary</strong>
                                    <div class="text-muted small">@entry.RequestKind</div>
                                </td>
                                <td>@entry.Model</td>
                                <td>@(entry.PromptTokens?.ToString() ?? "-")</td>
                                <td>@(entry.CompletionTokens?.ToString() ?? "-")</td>
                                <td>@(entry.TotalTokens?.ToString() ?? "-")</td>
                                <td>
                                    <span class="badge @entry.OutcomeBadgeClass">@entry.OutcomeLabel</span>
                                    @if (!entry.WasSuccessful && !string.IsNullOrWhiteSpace(entry.ErrorMessage))
                                    {
                                        <div class="text-muted small mt-1">@entry.ErrorMessage</div>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
