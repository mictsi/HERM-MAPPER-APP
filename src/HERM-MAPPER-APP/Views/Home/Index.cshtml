@using HERMMapperApp
@model HomeDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var canManageProductsAndServices = AppRoles.CanManageProductsAndServices(User);
}

<section class="hero-panel">
    <div>
        <h1>Welcome to HERM Mapper</h1>

        <div class="d-flex flex-wrap gap-3 mt-4">
            <a class="btn btn-outline-light btn-lg" asp-controller="Mappings" asp-action="Index">Open mapping board</a>
            @if (canManageProductsAndServices)
            {
                <a class="btn btn-primary btn-lg" asp-controller="Products" asp-action="Create">Add product</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Applications" asp-action="Create">Add application</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="BrmModels" asp-action="Create">Add BRM model</a>
            }
        </div>
    </div>
    <div class="hero-side">
        <div class="hero-metric">
            <span class="metric-label">Reference model</span>
            <span class="metric-value small">@Model.ReferenceModelStatus</span>
        </div>
    </div>
</section>

<section class="stats-grid">
    <article class="stat-card">
        <span class="stat-label">Products</span>
        <span class="stat-value">@Model.ProductCount</span>
        <span class="stat-meta">Catalogue items tracked</span>
    </article>
    <article class="stat-card">
        <span class="stat-label">Completed mappings</span>
        <span class="stat-value">@Model.CompletedMappings</span>
        <span class="stat-meta">Ready for CSV export</span>
    </article>
    <article class="stat-card">
        <span class="stat-label">BRM model</span>
        <span class="stat-value">@Model.BrmComponentCount</span>
        <span class="stat-meta">@Model.BrmDomainCount domain(s), @Model.BrmCapabilityCount capability node(s), @Model.BrmComponentCount component(s)</span>
    </article>
    <article class="stat-card">
        <span class="stat-label">ARM model</span>
        <span class="stat-value">@Model.ArmComponentCount</span>
        <span class="stat-meta">@Model.ArmDomainCount domain(s), @Model.ArmCapabilityCount capability node(s), @Model.ArmComponentCount component(s)</span>
    </article>
    <article class="stat-card">
        <span class="stat-label">TRM model</span>
        <span class="stat-value">@Model.TrmComponentCount</span>
        <span class="stat-meta">@Model.TrmDomainCount domain(s), @Model.TrmCapabilityCount capability node(s), @Model.TrmComponentCount component(s)</span>
    </article>
</section>

<section class="content-card">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Recent catalogue changes</span>
            <h2>Latest products</h2>
        </div>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Products" asp-action="Index">View all</a>
    </div>

    @if (Model.RecentProducts.Count == 0)
    {
        <div class="empty-state">
            <h3>No products yet</h3>
            <p>Add the products you want to classify, then use the mapping board to align them to HERM TRM.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Status</th>
                        <th>Mapped component</th>
                        <th>Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var product in Model.RecentProducts)
                {
                    var latestMapping = product.Mappings
                        .OrderByDescending(x => x.UpdatedUtc)
                        .FirstOrDefault();
                    <tr>
                        <td>
                            <strong>@product.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(product.Vendor))
                            {
                                <div class="table-subline">@product.Vendor @product.Version</div>
                            }
                        </td>
                        <td>
                            @if (latestMapping is null)
                            {
                                <span class="status-pill status-draft">Unmapped</span>
                            }
                            else
                            {
                                <span class="status-pill status-@latestMapping.MappingStatus.ToString().ToLowerInvariant()">@latestMapping.MappingStatus</span>
                            }
                        </td>
                        <td>@(latestMapping?.TrmComponent is null ? $"{product.Mappings.Count} mapping(s)" : latestMapping.TrmComponent.DisplayLabel)</td>
                        <td>@await TimeZoneDisplay.FormatUtcAsync(product.UpdatedUtc)</td>
                        <td class="text-end">
                            <div class="table-action-group">
                                <a class="table-action-button"
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   title="Show details for @product.Name"
                                   aria-label="Show details for @product.Name">
                                    <partial name="_ActionIcon" model="@("details")" />
                                    <span class="visually-hidden">Show details</span>
                                </a>
                                <a class="table-action-button"
                                   asp-controller="Products"
                                   asp-action="Visualize"
                                   asp-route-id="@product.Id"
                                   title="Visualize HERM mapping for @product.Name"
                                   aria-label="Visualize HERM mapping for @product.Name">
                                    <partial name="_ActionIcon" model="@("visualize")" />
                                    <span class="visually-hidden">Visualize HERM mapping</span>
                                </a>
                                <a class="table-action-button"
                                   asp-controller="Products"
                                   asp-action="ShowDependencies"
                                   asp-route-id="@product.Id"
                                   title="Show dependencies for @product.Name"
                                   aria-label="Show dependencies for @product.Name">
                                    <partial name="_ActionIcon" model="@("dependencies")" />
                                    <span class="visually-hidden">Show dependencies</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
