@model DrmDataEntityEditViewModel
@{
    ViewData["Title"] = "Edit DRM Data Entity";
    ViewData["BodyClass"] = "drm-models-page";
}

<section class="page-header">
    <div>
        <span class="eyebrow">Data Layer</span>
        <h1>Edit data entity</h1>
        <p>Update this DRM model selection.</p>
    </div>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/drm-data-entity-editor.js" asp-append-version="true"></script>
}
