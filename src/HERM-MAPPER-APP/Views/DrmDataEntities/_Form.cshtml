@model DrmDataEntityEditViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="content-card mb-4">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Data-entity record</span>
                    <h2>DRM selection</h2>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12">
                    <input type="hidden" asp-for="SelectedDrmModelId" />
                    <label asp-for="SelectedDrmModelId" class="form-label"></label>
                    <div class="content-card border-0 bg-light-subtle">
                        <dl class="detail-grid mb-0">
                            <dt>Name</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.DrmModelName) ? "-" : Model.DrmModelName)</dd>
                            <dt>Area</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.DrmModelArea) ? "-" : Model.DrmModelArea)</dd>
                            <dt>Status</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.DrmModelStatus) ? "-" : Model.DrmModelStatus)</dd>
                        </dl>
                    </div>
                    <span asp-validation-for="SelectedDrmModelId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="SelectedDrmEntityId" class="form-label"></label>
                    <select asp-for="SelectedDrmEntityId" class="form-select" asp-items="Model.EntityOptions">
                        <option value="">Choose a DRM entity</option>
                    </select>
                    <span asp-validation-for="SelectedDrmEntityId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="SelectedDrmCommonSubClassId" class="form-label"></label>
                    <select asp-for="SelectedDrmCommonSubClassId" class="form-select" asp-items="Model.CommonSubClassOptions">
                        <option value="">Use the entity itself</option>
                    </select>
                    <span asp-validation-for="SelectedDrmCommonSubClassId" class="text-danger"></span>
                    <div class="form-note mt-2">Choose a common sub-class only when this model should include that sub-class under the selected entity.</div>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <aside class="content-card h-100">
            <div class="section-heading">
                <div>
                    <span class="eyebrow">Workflow</span>
                    <h2>What this creates</h2>
                </div>
            </div>
            <p class="mb-3">This record stays inside the current DRM model and references only imported DRM catalogue objects.</p>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Save data entity</button>
                @if (Model.SelectedDrmModelId.HasValue)
                {
                    <a class="btn btn-outline-secondary" asp-controller="DrmModels" asp-action="Details" asp-route-id="@Model.SelectedDrmModelId">Cancel</a>
                }
                else
                {
                    <a class="btn btn-outline-secondary" asp-controller="DrmModels" asp-action="Index">Cancel</a>
                }
            </div>
        </aside>
    </div>
</div>
