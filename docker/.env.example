# ---------------------------------------------------------------------------
# HERM Mapper - docker configuration
#
#   cp docker/.env.example docker/.env.prod   # .env.prod is git-ignored
#   ./run.sh docker start prod                # or: --env-file docker/.env.prod
#
# Every value below is read by docker/docker-compose.yml or by the app itself
# (HERM_ prefixed keys map onto appsettings.json, __ separates sections).
# ---------------------------------------------------------------------------

# --- stack -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=herm-mapper
HERM_IMAGE=herm-mapper-app:local
ASPNETCORE_ENVIRONMENT=Production

# The env file compose itself loads into the container. Point this at the same
# file you pass to --env-file so the app sees these values too.
HERM_ENV_FILE=./.env.example

# --- where the app is published -------------------------------------------
# Host binding for the published port. 127.0.0.1 keeps the container private to
# the host so only the reverse proxy can reach it; use 0.0.0.0 to expose it.
HERM_HTTP_BIND=127.0.0.1
HERM_HTTP_PORT=8080

# Sub-path the app is served from. Examples:
#   /            -> http://localhost:8080/
#   /hermapp     -> https://myapp/hermapp        (proxy passes /hermapp through)
#   /mytestapp   -> http://localhost/mytestapp
# Requests outside the sub-path are redirected into it, and cookies are scoped
# to it, so two instances can share one hostname.
HERM_APP_BASE_PATH=/

# Behind a reverse proxy: trust X-Forwarded-For/Proto/Host and let the proxy do
# the HTTPS redirect. Set both to false only when the container is reached
# directly over HTTPS.
HERM_USE_FORWARDED_HEADERS=true
HERM_HTTPS_REDIRECTION=false

# Host names the app answers to. Narrow this in production, e.g. myapp.example.org
HERM_AllowedHosts=*

# --- container limits ------------------------------------------------------
HERM_CPU_LIMIT=2
HERM_MEMORY_LIMIT=1g
HERM_MEMORY_RESERVATION=256m
HERM_LOG_MAX_SIZE=10m
HERM_LOG_MAX_FILE=5
# Must match the image user (APP_UID) unless you rebuild with a different one.
HERM_RUN_AS_UID=1654
HERM_RUN_AS_GID=1654

# --- database --------------------------------------------------------------
# Provider accepts Sqlite (default) or SqlServer (also spelled sql-server/mssql).
# The connection string is taken from the first of these that is set:
#   HERM_Database__ConnectionString
#   HERM_ConnectionStrings__Sqlite      (Sqlite)   /  __SqlServer (SQL Server)
#   HERM_ConnectionStrings__DefaultConnection
#
# Option A - Sqlite. The file lives on the app-data volume. |DataDirectory| and
# |HomeDirectory| tokens, plus $VAR / ${VAR} environment variables, are expanded.
HERM_Database__Provider=Sqlite
HERM_Database__SqliteFilePath=/app/App_Data/herm-mapper.db
HERM_Database__ConnectionString=Data Source=/app/App_Data/herm-mapper.db
HERM_ConnectionStrings__Sqlite=Data Source=/app/App_Data/herm-mapper.db
HERM_ConnectionStrings__DefaultConnection=Data Source=/app/App_Data/herm-mapper.db

# Option B - SQL Server. Comment out the five Sqlite lines above and uncomment
# the block below; the app fails to start with SqlServer and no connection
# string. Do not commit a file that holds the real password - keep it in
# docker/.env.prod (git-ignored) or inject it from your secret store.
#
#HERM_Database__Provider=SqlServer
#HERM_Database__ConnectionString=Server=tcp:sql-host.example.org,1433;Database=herm-mapper;User ID=herm_app;Password=ChangeMeNow!123;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Connect Timeout=30
#HERM_ConnectionStrings__SqlServer=Server=tcp:sql-host.example.org,1433;Database=herm-mapper;User ID=herm_app;Password=ChangeMeNow!123;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Connect Timeout=30
#
# Windows / integrated auth (container must have a machine account or gMSA):
#HERM_Database__ConnectionString=Server=tcp:sql-host.example.org,1433;Database=herm-mapper;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True
#
# Azure SQL:
#HERM_Database__ConnectionString=Server=tcp:myserver.database.windows.net,1433;Initial Catalog=herm-mapper;Persist Security Info=False;User ID=herm_app;Password=ChangeMeNow!123;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30
#
# LocalDB / named instance reachable from the container (host.docker.internal on
# Docker Desktop). TrustServerCertificate=True only for a dev self-signed cert:
#HERM_Database__ConnectionString=Server=host.docker.internal,1433;Database=herm-mapper;User ID=sa;Password=ChangeMeNow!123;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True
#
# The password may hold characters the shell dislikes; the value is read
# verbatim from the env file, so do not quote or escape it. A ';' inside the
# password must be wrapped: Password={pa;ss}

# --- first-run data --------------------------------------------------------
HERM_HermWorkbook__AutoImportOnFirstRun=false
HERM_SampleRelationships__AutoImportOnFirstRun=false

# --- security --------------------------------------------------------------
# Only used while the user table is empty. Change it before the first start.
HERM_Security__BootstrapAdmin__GivenName=System
HERM_Security__BootstrapAdmin__LastName=Administrator
HERM_Security__BootstrapAdmin__Email=admin@local
HERM_Security__BootstrapAdmin__UserName=admin
HERM_Security__BootstrapAdmin__Password=ChangeMeNow!123

# Cookies are marked Secure based on the request scheme. With TLS ending at the
# proxy the container itself sees plain HTTP, so let the forwarded scheme decide;
# set this to true only when the app is reached over HTTPS directly.
HERM_Security__Authentication__RequireHttpsCookies=false

HERM_Security__Authentication__SessionTimeoutMinutes=60
HERM_Security__Authentication__MaxFailedLoginAttempts=15
HERM_Security__Authentication__LockoutMinutes=1
HERM_Security__Authentication__Local__Enabled=true

# --- OpenID Connect (optional) ---------------------------------------------
HERM_Security__Authentication__OpenIdConnect__Enabled=false
HERM_Security__Authentication__OpenIdConnect__DisplayName=OpenID Connect
HERM_Security__Authentication__OpenIdConnect__Authority=
HERM_Security__Authentication__OpenIdConnect__ClientId=
HERM_Security__Authentication__OpenIdConnect__ClientSecret=
HERM_Security__Authentication__OpenIdConnect__CallbackPath=/signin-oidc
HERM_Security__Authentication__OpenIdConnect__SignedOutCallbackPath=/signout-callback-oidc
HERM_Security__Authentication__OpenIdConnect__RequireHttpsMetadata=true
HERM_Security__Authentication__OpenIdConnect__GetClaimsFromUserInfoEndpoint=false
HERM_Security__Authentication__OpenIdConnect__EmitTokensAndClaimsToConsole=false
HERM_Security__Authentication__OpenIdConnect__NameClaimType=name
HERM_Security__Authentication__OpenIdConnect__EmailClaimType=email
HERM_Security__Authentication__OpenIdConnect__GivenNameClaimType=given_name
HERM_Security__Authentication__OpenIdConnect__SurnameClaimType=family_name
HERM_Security__Authentication__OpenIdConnect__GroupClaimType=groups
HERM_Security__Authentication__OpenIdConnect__SubjectClaimType=sub
HERM_Security__Authentication__OpenIdConnect__Scopes__0=openid
HERM_Security__Authentication__OpenIdConnect__Scopes__1=profile
HERM_Security__Authentication__OpenIdConnect__Scopes__2=email

# --- diagnostics -----------------------------------------------------------
HERM_Diagnostics__Console__Enabled=true
HERM_Diagnostics__Console__LogLevel=Information
HERM_Diagnostics__Sql__Enabled=false
HERM_Diagnostics__Sql__LogLevel=Error
HERM_Diagnostics__Sql__IncludeSensitiveData=false
HERM_Diagnostics__Sql__EnableDetailedErrors=false
HERM_Caching__LookupRefreshIntervalMinutes=2
HERM_Logging__LogLevel__Default=Information
HERM_Logging__LogLevel__Microsoft.AspNetCore=Error
HERM_Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
